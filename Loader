local SETTINGS_FILE = "S14xFluentSettings.json"

local function SaveSettings(data)
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and encoded then
        pcall(function() writefile(SETTINGS_FILE, encoded) end)
    end
end

local function LoadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local okc, content = pcall(readfile, SETTINGS_FILE)
        if okc and content and content ~= "" then
            local ok, dec = pcall(function() return HttpService:JSONDecode(content) end)
            if ok then return dec end
        end
    end
