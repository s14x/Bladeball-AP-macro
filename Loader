local function loadConfig()
    local data = LoadSettings()
    if data then
        for k, v in pairs(data) do
            if k == "Keybind" or k == "TriggerBotKeybind" then
                local e = Enum.KeyCode[v]
                if e then Config[k] = e end
            elseif k == "Headless" then
                -- legacy key, handled below
            elseif Config[k] ~= nil then
                Config[k] = v
            end
        end
        -- legacy translation: Headless boolean -> HeadlessMode
        if data.HeadlessMode == nil and data.Headless ~= nil then
            if data.Headless then
                Config.HeadlessMode = "V1"
            else
                Config.HeadlessMode = "Off"
            end
        end
    end
    if typeof(Config.TargetCPS) ~= "number" then Config.TargetCPS = 200 end
    Config.TargetCPS = math.clamp(Config.TargetCPS, 5, 500)
    Config.TargetCPS = math.floor((Config.TargetCPS + 2.5) / 5) * 5
    Config.TargetCPS = math.clamp(Config.TargetCPS, 5, 500)
    if typeof(Config.AutoParryAccuracy) ~= "number" then Config.AutoParryAccuracy = 100 end
    Config.AutoParryAccuracy = math.clamp(Config.AutoParryAccuracy, 1, 100)
    if typeof(Config.TriggerBotDistance) ~= "number" then Config.TriggerBotDistance = 1 end
    Config.TriggerBotDistance = math.clamp(Config.TriggerBotDistance, 1, 1.5)
    if Config.ParryMethod ~= "Legit" and Config.ParryMethod ~= "Blatant" then Config.ParryMethod = "Legit" end
    if Config.SafeSwordChanger == nil then Config.SafeSwordChanger = true end
    if Config.StrictCategory == nil then Config.StrictCategory = true end
    if Config.SaveLastEquipped == nil then Config.SaveLastEquipped = true end
    if Config.HeadlessMode ~= "Off" and Config.HeadlessMode ~= "V1" and Config.HeadlessMode ~= "V2" then
        Config.HeadlessMode = "Off"
    end
    if typeof(Config.AvatarWorn) ~= "string" then Config.AvatarWorn = "" end

    NeverZen.Theme.Hightlight = Color3.fromRGB(Config.ThemeColorR, Config.ThemeColorG, Config.ThemeColorB)
    if NeverZen.UpdateHighlightColor then NeverZen:UpdateHighlightColor() end
end

