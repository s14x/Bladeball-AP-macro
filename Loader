local function GuessCategoryFromName(swordName)
    if not swordName or swordName == "" then return nil end
    local low = swordName:lower()
    for _, rule in ipairs(NAME_CATEGORY_RULES) do
        if low:find(rule.pattern, 1, true) then return rule.cat end
    end
    return "Sword"
end

local SwordCategoryCache = {}
local function GetSwordCategory(swordName)
    if not swordName or swordName == "" then return nil end
    if SwordCategoryCache[swordName] ~= nil then return SwordCategoryCache[swordName] end

    -- 1) Manual override first
    local override = SWORD_CATEGORY_OVERRIDES[swordName]
    if override then
        SwordCategoryCache[swordName] = override
        return override
    end

    -- 2) Ask the game module (name-variant aware, never spams remotes)
    local category = nil
    local data = SwordPreview.GetModuleData(swordName)
    if type(data) == "table" then
        category = data.AnimationType or data.SwordType or data.Type or data.Category
    end

    -- 3) Name-based fallback
    if not category then category = GuessCategoryFromName(swordName) end
    category = CanonicalCategory(category) or category

    -- 4) Safety net — Greatscythes / Kingscythes are Greatswords
    if category == "Scythe" then
        local low = swordName:lower()
        if low:find("greatscythe", 1, true) or low:find("kingscythe", 1, true) then
            category = "Greatsword"
        end
    end

    SwordCategoryCache[swordName] = category
    return category
end

