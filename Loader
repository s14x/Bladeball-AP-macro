-- ============================================================
-- MACRO LOOP
-- ============================================================
local timeAccumulator = 0

-- The macro is scheduled on RenderStepped instead of PreSimulation.
-- PreSimulation only ticks at the SIMULATION rate (60Hz), so at high
-- CPS the whole frame's worth of parries had to be fired in ONE burst
-- (e.g. 8 in the same tick at 500 CPS) -- the server reads that as a
-- single clump. RenderStepped ticks every render frame (120-240Hz on
-- a normal rig), so the SAME CPS is spread across many more ticks:
-- each parry goes out as its own, the spam lands more reliably and
-- feels snappier. The CPS slider (5-500) and the fire count per
-- second are unchanged -- the scheduling is just finer.
local _macroParryData = nil   -- GetParryData() snapshot, ~25Hz refresh
local _macroDataStamp = 0

local function MacroBurst(fires)
    if not _capturedRemote or not _capturedArgs or not _tokenFound or not _token then return end
    local data = _macroParryData
    if not data then return end
    -- the token is server-time based, so it must be fresh every burst
    local okTok, token = pcall(_tokenize, _capturedArgs[2])
    if not okTok or not token or token == "" then return end
    pcall(function()
        local remote  = _capturedRemote
        local a1      = _capturedArgs[1]
        local a2      = _capturedArgs[2]
        local cframe  = data.CFrame
        local pos     = data.Positions
        local mouse   = data.Mouse
        -- ONE closure + ONE pcall for the WHOLE burst instead of one
        -- of each per fire (saves the per-fire allocation at 500 CPS)
        for _ = 1, fires do
            remote:FireServer(a1, a2, token, 0.5, cframe, pos, mouse, false)
        end
    end)
end

RunService.RenderStepped:Connect(function(dt)
    if not Config.Spamming then timeAccumulator = 0 return end
    if Config.SafeMode and not IsBlockLegit() then timeAccumulator = 0 return end
    if Config.ParryMethod == "Legit" and not ShouldFireLegit() then timeAccumulator = 0 return end

    local now = os.clock()
    if not _macroParryData or now - _macroDataStamp >= 0.04 then
        _macroParryData = GetParryData()
        _macroDataStamp = now
    end

    local targetCPS = math.clamp(Config.TargetCPS or 200, 5, 500)
    local interval  = 1 / targetCPS
    timeAccumulator += dt
    if timeAccumulator >= interval then
        local fires = math.floor(timeAccumulator / interval)
        timeAccumulator -= fires * interval
        if timeAccumulator > interval * 2 then timeAccumulator = 0 end
        if fires > 200 then fires = 200 end
        MacroBurst(fires)
        if Config.MacroAnimationFix then SpamParryAnimation() end
    end
end)

