        -- resolves a classic clothing catalog id to its real IMAGE id
        -- (setting ShirtTemplate to the catalog id renders nothing)
        local resolveTemplateHttp = function(id)
            local body = FN.rawHttp("https://assetdelivery.roblox.com/v1/asset/?id=" .. tostring(math.floor(id)))
            if not body then return nil end
            local text = tostring(body)
            local imageId = string.match(text, "<url>[^<]-id=(%d+)")
                or string.match(text, "rbxassetid://(%d+)")
            if imageId then return "rbxassetid://" .. imageId end
            return nil
        end

