        FN.accFromTable = function(list)
            local out = {}
            if type(list) == "table" then
                for i, e in ipairs(list) do
                    local entry = { AssetId = tonumber(e.AssetId) or 0 }
                    local at = tonumber(e.AType)
                    if at and ATYPE_ENUM[at] then entry.AccessoryType = ATYPE_ENUM[at] end
                    if e.IsLayered then entry.IsLayered = true end
                    if e.Order then entry.Order = tonumber(e.Order) end
                    if e.Puffiness then entry.Puffiness = tonumber(e.Puffiness) end
                    out[i] = entry
                end
            end
            return out
        end

        FN.descToTable = function(d)
            local out = { _acc = {} }
            for _, f in ipairs(DESC_FIELDS) do
                local ok, v = pcall(function() return d[f] end)
                if ok then
                    local sv = FN.jsonSafe(v)
                    if sv ~= nil then out[f] = sv end
                end
            end
            local ok2, acc = pcall(function() return d:GetAccessories(true) end)
            if ok2 and type(acc) == "table" then
                for i, e in ipairs(acc) do
                    out._acc[i] = FN.accEntryToJson(e)
                end
            end
            return out
        end

        FN.tableToDesc = function(t)
            local d = Instance.new("HumanoidDescription")
            if type(t) == "table" then
                for _, f in ipairs(DESC_FIELDS) do
                    local v = t[f]
                    if v ~= nil then
                        local cur
                        pcall(function() cur = d[f] end)
                        if typeof(cur) == "BrickColor" then
                            pcall(function() d[f] = BrickColor.new(v) end)
                        else
                            pcall(function() d[f] = v end)
                        end
                    end
                end
            end
            return d
        end

        -- builds custom items on top of a base description (used for the
        -- viewport previews - the character itself wears real instances)
        FN.buildOn = function(desc, baseAcc, items)
            for _, it in ipairs(items) do
                if it.field and it.mode ~= "accessory" and it.mode ~= "gear" then
                    pcall(function() desc[it.field] = it.id end)
                end
            end
            if baseAcc then
                local list = {}
                for _, e in ipairs(baseAcc) do table.insert(list, e) end
                local order = #list
                for _, it in ipairs(items) do
                    if it.mode == "accessory" then
                        local entry = { AssetId = it.id }
                        if it.atype and ATYPE_ENUM[it.atype] then
                            entry.AccessoryType = ATYPE_ENUM[it.atype]
                        end
                        if it.layered then
                            entry.IsLayered = true
                            order = order + 1
                            entry.Order = order
                        end
                        table.insert(list, entry)
                    end
                end
                pcall(function() desc:SetAccessories(list, true) end)
            else
                -- GetAccessories unavailable: append rigid customs to the string fields
                for _, it in ipairs(items) do
                    if it.mode == "accessory" and not it.layered
                        and it.atype and RIGID_FIELD[it.atype] then
                        local f = RIGID_FIELD[it.atype]
                        local cur = ""
                        pcall(function() cur = tostring(desc[f] or "") end)
                        if cur == "" then
                            desc[f] = tostring(math.floor(it.id))
                        else
                            desc[f] = cur .. "," .. tostring(math.floor(it.id))
                        end
                    end
                end
            end
            return desc
        end

        -- returns: desc (HumanoidDescription of the base look), accList (table or nil)
        FN.getBase = function()
            if State.base then
                local d = FN.tableToDesc(State.base.fields)
                return d, FN.accFromTable(State.base.accessories)
            end
            local orig = OriginalDescription or FN.captureOriginal(false)
            if orig then
                local d = FN.cloneDescription(orig)
                local ok, acc = pcall(function() return orig:GetAccessories(true) end)
                if ok and type(acc) == "table" then return d, acc end
                return d, nil
            end
            return Instance.new("HumanoidDescription"), {}
        end

        FN.composeDescription = function()
            local desc, baseAcc = FN.getBase()
            return FN.buildOn(desc, baseAcc, State.items)
        end

        FN.composeFromSaved = function(av)
            if type(av) ~= "table" then return Instance.new("HumanoidDescription") end
            local baseT = av.base or {}
            local desc = FN.tableToDesc(baseT)
            local baseAcc = FN.accFromTable(baseT._acc)
            return FN.buildOn(desc, baseAcc, av.items or {})
        end

        -- ===== asset loading =====
        FN.loadAssetObjects = function(id)
            local objs
            for _, uri in ipairs({
                "rbxassetid://" .. tostring(math.floor(id)),
                "http://www.roblox.com/asset/?id=" .. tostring(math.floor(id)),
                "https://www.roblox.com/asset/?id=" .. tostring(math.floor(id)),
            }) do
                local ok, loaded = pcall(function() return game:GetObjects(uri) end)
                if ok and type(loaded) == "table" and #loaded > 0 then
                    objs = loaded
                    break
                end
            end
            if not objs then
                pcall(function()
                    local m = InsertService:LoadAsset(math.floor(id))
                    if m then
                        objs = {}
                        for _, c in ipairs(m:GetChildren()) do
                            table.insert(objs, c)
                        end
                    end
                end)
            end
            if type(objs) ~= "table" then return nil end
            return objs
        end

        FN.findInObjects = function(objs, class)
            if type(objs) ~= "table" then return nil end
            for _, o in ipairs(objs) do
                if o:IsA(class) then return o end
                local f = o:FindFirstChildWhichIsA(class, true)
                if f then return f end
            end
            return nil
        end

        FN.destroyObjects = function(objs)
            if type(objs) == "table" then
                for _, o in ipairs(objs) do
                    pcall(function() o:Destroy() end)
                end
            end
        end

        -- ===== accessory attachment (engine weld + manual weld fallback) =====
        local ATTACH_FALLBACKS = {
            "HairAttachment", "HatAttachment", "FaceFrontAttachment", "FaceCenterAttachment",
            "NeckAttachment", "BodyFrontAttachment", "BodyBackAttachment",
            "LeftCollarAttachment", "RightCollarAttachment",
            "WaistCenterAttachment", "WaistFrontAttachment", "WaistBackAttachment",
        }

        FN.findCharAttachment = function(char, name)
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    local a = part:FindFirstChild(name)
                    if a and a:IsA("Attachment") then return a end
                end
            end
            return nil
        end

        FN.hasLiveWeld = function(handle)
            for _, d in ipairs(handle:GetChildren()) do
                if (d:IsA("Weld") or d:IsA("Motor6D")) and d.Part0 and d.Part1 then
                    return true
                end
            end
            return false
        end

        FN.attachAccessory = function(char, hum, acc, allowWeld)
            local handle = acc:FindFirstChild("Handle") or acc:FindFirstChildWhichIsA("BasePart")
            if not handle then return false, "no Handle in asset" end

            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
            if root then pcall(function() handle.CFrame = root.CFrame end) end

            acc.Parent = nil
            pcall(function() hum:AddAccessory(acc) end)
            if acc.Parent ~= char then
                local okParent = pcall(function() acc.Parent = char end)
                if not okParent then return false, "could not parent accessory" end
            end

            pcall(function()
                handle.Anchored = false
                handle.CanCollide = false
                handle.Massless = true
                handle.AssemblyLinearVelocity = Vector3.zero
                handle.AssemblyAngularVelocity = Vector3.zero
            end)

            if FN.hasLiveWeld(handle) then return true, "engine weld" end
            if allowWeld == false then return true, "layered" end

            local hAtt
            for _, d in ipairs(handle:GetChildren()) do
                if d:IsA("Attachment") then
                    hAtt = d
                    break
                end
            end

            local charAtt = hAtt and FN.findCharAttachment(char, hAtt.Name) or nil
            if not charAtt then
                for _, n in ipairs(ATTACH_FALLBACKS) do
                    charAtt = FN.findCharAttachment(char, n)
                    if charAtt then break end
                end
            end

            local weld = Instance.new("Weld")
            weld.Name = "ITSAvatarWeld"
            weld.Part1 = handle

            if charAtt and charAtt.Parent then
                weld.Part0 = charAtt.Parent
                weld.C0 = charAtt.CFrame
                weld.C1 = hAtt and hAtt.CFrame or CFrame.new()
            else
                local head = char:FindFirstChild("Head") or root
                if not head then return false, "no attachment point" end
                weld.Part0 = head
                local okCF = pcall(function()
                    weld.C0 = CFrame.fromMatrix(acc.AttachmentPos, acc.AttachmentRight, acc.AttachmentUp, -acc.AttachmentForward)
                end)
                if not okCF then weld.C0 = CFrame.new(0, 0.5, 0) end
            end

            weld.Parent = handle
            return true, charAtt and ("welded to " .. charAtt.Name) or "legacy weld"
        end

        -- ===== classic clothing (real template ids, not the catalog id) =====
        local CLOTHING_PROP = {
            Shirt = "ShirtTemplate", Pants = "PantsTemplate",
            ShirtGraphic = "Graphic", Decal = "Texture",
        }
        local templateCache = {}
        local clothingBack = {}   -- ["Shirt"] = { inst =, template =, created = }

        FN.templateFrom = function(source, className, id)
            local prop = CLOTHING_PROP[className]
            if source and prop then
                local ok, v = pcall(function() return source[prop] end)
                if ok and type(v) == "string" and v ~= "" then
                    return v, true
                end
            end
            if templateCache[id] then return templateCache[id], true end
            local ok, viaHttp = pcall(resolveTemplateHttp, id)
            if ok and viaHttp then
                templateCache[id] = viaHttp
                return viaHttp, true
            end
            return "rbxassetid://" .. tostring(math.floor(id)), false
        end

        FN.applyClothing = function(char, source, id, className, noTrack)
            local prop = CLOTHING_PROP[className]
            if not prop then return false end
            local template, resolved = FN.templateFrom(source, className, id)

            if className == "Shirt" or className == "Pants" or className == "ShirtGraphic" then
                local existing = char:FindFirstChildOfClass(className)
                if existing then
                    if not noTrack and not clothingBack[className] then
                        clothingBack[className] = { inst = existing, template = existing[prop], created = false }
                    end
                    pcall(function() existing[prop] = template end)
                else
                    local fresh = Instance.new(className)
                    pcall(function() fresh[prop] = template end)
                    fresh.Parent = char
                    if not noTrack then
                        clothingBack[className] = { inst = fresh, template = "", created = true }
                    end
                end
                return true, resolved
            end

            if className == "Decal" then -- classic face
                local head = char:FindFirstChild("Head")
                if not head then return false end
                local face = head:FindFirstChildOfClass("Decal")
                if face then
                    if not noTrack and not clothingBack.Face then
                        clothingBack.Face = { inst = face, template = face.Texture, created = false }
                    end
                    pcall(function() face.Texture = template end)
                else
                    local fresh = Instance.new("Decal")
                    fresh.Name = "face"
                    fresh.Face = Enum.NormalId.Front
                    pcall(function() fresh.Texture = template end)
                    fresh.Parent = head
                    if not noTrack then
                        clothingBack.Face = { inst = fresh, template = "", created = true }
                    end
                end
                return true, resolved
            end

            return false
        end

        FN.revertClothing = function(key)
            local b = clothingBack[key]
            if not b then return end
            clothingBack[key] = nil
            if b.created then
                pcall(function() b.inst:Destroy() end)
                return
            end
            if b.inst and b.inst.Parent then
                local prop = (key == "Face") and "Texture" or CLOTHING_PROP[key]
                if prop then pcall(function() b.inst[prop] = b.template end) end
            end
        end

        -- ===== client-side head swap =====
        local headSwapPart = nil
        local headSwapBackup = nil
        local headSwapDynamic = false

        FN.findHeadSource = function(objs)
            if type(objs) ~= "table" then return nil end
            for _, root in ipairs(objs) do
                if root:IsA("BasePart") and root.Name == "Head" then return root end
                local named = root:FindFirstChild("Head", true)
                if named and named:IsA("BasePart") then return named end
            end
            for _, root in ipairs(objs) do
                if root:IsA("BasePart") then return root end
                local part = root:FindFirstChildWhichIsA("BasePart", true)
                if part then return part end
            end
            -- some classic head assets insert only a SpecialMesh
            for _, root in ipairs(objs) do
                if root:IsA("SpecialMesh") then return root end
                local mesh = root:FindFirstChildWhichIsA("SpecialMesh", true)
                if mesh then return mesh end
            end
            return nil
        end

        FN.cleanupStrayHeadSwaps = function(char)
            char = char or LocalPlayer.Character
            if not char then return end
            for _, d in ipairs(char:GetDescendants()) do
                if d.Name == "ITSAvatarHeadSwap" or d.Name == "ITSAvatarHeadSwapWeld" then
                    pcall(function() d:Destroy() end)
                end
            end
        end

        FN.revertHeadSwap = function()
            if headSwapPart then
                pcall(function() headSwapPart:Destroy() end)
                headSwapPart = nil
            end
            local b = headSwapBackup
            headSwapBackup = nil
            if b and b.part and b.part.Parent then
                pcall(function() b.part.Transparency = b.transparency end)
                pcall(function() b.part.LocalTransparencyModifier = b.ltm or 0 end)
                for _, e in ipairs(b.decals or {}) do
                    if e.inst and e.inst.Parent then
                        pcall(function() e.inst.Transparency = e.transparency end)
                    end
                end
            end
            return (b ~= nil)
        end

        FN.applyHeadAsset = function(headId, isDynamic)
            local char = LocalPlayer.Character
            local realHead = char and char:FindFirstChild("Head")
            if not realHead then return false, "no character head" end

            FN.revertHeadSwap()
            FN.cleanupStrayHeadSwaps(char)

            local objs = FN.loadAssetObjects(headId)
            local source = FN.findHeadSource(objs)
            if not source then
                FN.destroyObjects(objs)
                return false, "head asset could not be loaded"
            end

            local okClone, fake = pcall(function()
                if source:IsA("BasePart") then
                    return source:Clone()
                end
                if source:IsA("SpecialMesh") then
                    local part = Instance.new("Part")
                    local mesh = source:Clone()
                    mesh.Parent = part
                    return part
                end
                return nil
            end)
            if not okClone or not fake or not fake:IsA("BasePart") then
                FN.destroyObjects(objs)
                return false, "head asset has no renderable part"
            end

            headSwapBackup = {
                part = realHead, transparency = realHead.Transparency,
                ltm = realHead.LocalTransparencyModifier, decals = {},
            }
            for _, d in ipairs(realHead:GetChildren()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    table.insert(headSwapBackup.decals, { inst = d, transparency = d.Transparency })
                end
            end

            -- classic head shapes carry geometry only: copy the face decal
            -- so the head is not faceless
            if not isDynamic and not fake:FindFirstChildWhichIsA("Decal") then
                for _, d in ipairs(realHead:GetChildren()) do
                    if d:IsA("Decal") then
                        local okFace, faceClone = pcall(function() return d:Clone() end)
                        if okFace and faceClone then
                            faceClone.Name = "face"
                            faceClone.Transparency = 0
                            faceClone.Parent = fake
                            break
                        end
                    end
                end
            end

            pcall(function() realHead.Transparency = 1 end)
            pcall(function() realHead.LocalTransparencyModifier = 1 end)
            for _, e in ipairs(headSwapBackup.decals) do
                pcall(function() e.inst.Transparency = 1 end)
            end

            fake.Name = "ITSAvatarHeadSwap"
            pcall(function() fake.Anchored = false end)
            pcall(function() fake.CanCollide = false end)
            pcall(function() fake.CanQuery = false end)
            pcall(function() fake.CanTouch = false end)
            pcall(function() fake.Massless = true end)
            if isDynamic then
                pcall(function() fake.Color = Color3.fromRGB(255, 255, 255) end)
                pcall(function() fake.Material = Enum.Material.Plastic end)
                local dm = fake:FindFirstChildWhichIsA("SpecialMesh")
                if dm then pcall(function() dm.VertexColor = Vector3.new(1, 1, 1) end) end
            else
                local bodyColors = char:FindFirstChildOfClass("BodyColors")
                local skinColor = (bodyColors and bodyColors.HeadColor3) or realHead.Color
                pcall(function() fake.Color = skinColor end)
                pcall(function() fake.Material = realHead.Material end)
            end
            -- preserve the source aspect ratio; stretching directly to the
            -- current head size distorts dynamic head textures
            pcall(function()
                local sourceSize = realHead.Size
                if source:IsA("BasePart") then
                    sourceSize = source.Size
                elseif source.Parent and source.Parent:IsA("BasePart") then
                    sourceSize = source.Parent.Size
                end
                local scale = (sourceSize.Y > 0) and (realHead.Size.Y / sourceSize.Y) or 1
                fake.Size = sourceSize * scale
            end)
            pcall(function() fake.Transparency = 0 end)
            pcall(function() fake.CFrame = realHead.CFrame end)
            fake.Parent = char

            local weld = Instance.new("Weld")
            weld.Name = "ITSAvatarHeadSwapWeld"
            weld.Part0 = realHead
            weld.Part1 = fake
            weld.C0 = CFrame.new()
            weld.C1 = CFrame.new()
            weld.Parent = fake
            headSwapPart = fake
            headSwapDynamic = isDynamic and true or false

            pcall(function()
                game:GetService("ContentProvider"):PreloadAsync({ fake })
            end)
            -- appearance code can restore the head while loading - assert again
            pcall(function() realHead.Transparency = 1 end)
            for _, e in ipairs(headSwapBackup.decals) do
                pcall(function() e.inst.Transparency = 1 end)
            end

            FN.destroyObjects(objs)
            return true, isDynamic and "dynamic head" or "classic head"
        end

        -- ===== gear =====
        FN.equipGearItem = function(it)
            local objs = FN.loadAssetObjects(it.id)
            local tool = FN.findInObjects(objs, "Tool")
            if not tool then
                FN.destroyObjects(objs)
                return false
            end
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if not backpack then
                pcall(function() tool:Destroy() end)
                return false
            end
            tool.Parent = backpack
            table.insert(ActiveGear, { id = it.id, tool = tool })
            task.delay(0.15, function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and tool.Parent then
                    pcall(function() hum:EquipTool(tool) end)
                end
            end)
            return true
        end

        FN.getRigType = function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.RigType == Enum.HumanoidRigType.R6 then
                return Enum.HumanoidRigType.R6
            end
            return Enum.HumanoidRigType.R15
        end

        -- ===== body parts: classic CharacterMesh (R6) AND modern package
        -- MeshParts (R15 bundles like Korblox) =====
        local wornBodyParts = {}   -- [id] = { meshes = {}, limbs = {} }

        -- limb aliases: a part named for one rig can still land on the other
        -- rig's matching limb (R6 "LeftLeg" -> R15 LeftUpperLeg etc). without
        -- this, cross-rig parts failed with "doesn't fit your avatar's rig"
        local LIMB_MAP = {
            alias = {
                head          = { "Head" },
                torso         = { "Torso", "UpperTorso" },
                uppertorso    = { "UpperTorso", "Torso" },
                lowertorso    = { "LowerTorso", "Torso" },
                leftarm       = { "LeftArm", "LeftUpperArm" },
                rightarm      = { "RightArm", "RightUpperArm" },
                leftupperarm  = { "LeftUpperArm", "LeftArm" },
                rightupperarm = { "RightUpperArm", "RightArm" },
                leftlowerarm  = { "LeftLowerArm", "LeftArm" },
                rightlowerarm = { "RightLowerArm", "RightArm" },
                lefthand      = { "LeftHand", "LeftArm" },
                righthand     = { "RightHand", "RightArm" },
                leftleg       = { "LeftLeg", "LeftUpperLeg" },
                rightleg      = { "RightLeg", "RightUpperLeg" },
                leftupperleg  = { "LeftUpperLeg", "LeftLeg" },
                rightupperleg = { "RightUpperLeg", "RightLeg" },
                leftlowerleg  = { "LeftLowerLeg", "LeftLeg" },
                rightlowerleg = { "RightLowerLeg", "RightLeg" },
                leftfoot      = { "LeftFoot", "LeftLeg" },
                rightfoot     = { "RightFoot", "RightLeg" },
            },
            keys = {},
            slot = { Head = "head", Torso = "torso", LArm = "leftarm",
                RArm = "rightarm", LLeg = "leftleg", RLeg = "rightleg" },
        }
        do
            local ks = {}
            for k in pairs(LIMB_MAP.alias) do table.insert(ks, k) end
            table.sort(ks, function(a, b) return #a > #b end)
            LIMB_MAP.keys = ks
        end

        FN.limbForKey = function(char, key)
            local names = LIMB_MAP.alias[key]
            if not names then return nil end
            for _, nm in ipairs(names) do
                local t = char:FindFirstChild(nm)
                if t and t:IsA("BasePart") then return t end
            end
            return nil
        end

        FN.matchCharPart = function(char, partName)
            local p = char:FindFirstChild(partName)
            if p and p:IsA("BasePart") then return p end
            local norm = string.gsub(partName, "%s+", ""):lower()
            if norm ~= "" then
                for _, d in ipairs(char:GetChildren()) do
                    if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                        local dn = string.gsub(d.Name, "%s+", ""):lower()
                        if string.find(norm, dn, 1, true) or string.find(dn, norm, 1, true) then
                            return d
                        end
                    end
                end
                -- "KorbloxDeathspeakerLeftArm", "Woman-LeftLeg", R6 names on
                -- R15 rigs and vice versa: match any known limb keyword
                for _, k in ipairs(LIMB_MAP.keys) do
                    if string.find(norm, k, 1, true) then
                        local t = FN.limbForKey(char, k)
                        if t then return t end
                    end
                end
            end
            return nil
        end

        FN.restoreLimbEntry = function(e)
            pcall(function()
                if e.orig and e.orig.Parent then
                    local tr = e.orig:GetAttribute("ITSLimbTr")
                    if tr == nil then tr = e.tr or 0 end
                    e.orig.Transparency = tr
                    local ltm = e.orig:GetAttribute("ITSLimbLtm")
                    if ltm == nil then ltm = e.ltm or 0 end
                    e.orig.LocalTransparencyModifier = ltm
                    for _, d in ipairs(e.decals or {}) do
                        if d.inst and d.inst.Parent then
                            d.inst.Transparency = d.tr
                        end
                    end
                end
                if e.clone then e.clone:Destroy() end
            end)
        end

        -- safety net: unhide any limb whose swap part vanished without a
        -- proper restore (this is what made limbs disappear before)
        FN.repairLimbs = function(char)
            if not char then return end
            for _, d in ipairs(char:GetChildren()) do
                if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart"
                    and d:GetAttribute("ITSLimbTr") ~= nil then
                    local hasClone = false
                    for _, c in ipairs(char:GetChildren()) do
                        if c:IsA("BasePart") and c.Name == "ITSAvatarLimb_" .. d.Name then
                            hasClone = true
                            break
                        end
                    end
                    if not hasClone then
                        pcall(function()
                            d.Transparency = d:GetAttribute("ITSLimbTr")
                            d.LocalTransparencyModifier = d:GetAttribute("ITSLimbLtm") or 0
                            d:SetAttribute("ITSLimbTr", nil)
                            d:SetAttribute("ITSLimbLtm", nil)
                        end)
                    end
                end
            end
        end

        -- hides the real limb and welds the package's MeshPart over it; the
        -- hidden limb keeps animating, so the replacement follows perfectly
        FN.replaceLimbPart = function(char, orig, clone, rec)
            -- remember the true visibility only once, and drop any previous
            -- swap on the same limb so stacking can't corrupt the restore
            if orig:GetAttribute("ITSLimbTr") == nil then
                pcall(function() orig:SetAttribute("ITSLimbTr", orig.Transparency) end)
                pcall(function() orig:SetAttribute("ITSLimbLtm", orig.LocalTransparencyModifier) end)
            end
            for _, d in ipairs(char:GetChildren()) do
                if d:IsA("BasePart") and d.Name == "ITSAvatarLimb_" .. orig.Name then
                    pcall(function() d:Destroy() end)
                end
            end
            local entry = {
                orig = orig, clone = clone,
                tr = orig:GetAttribute("ITSLimbTr") or 0,
                ltm = orig:GetAttribute("ITSLimbLtm") or 0,
                decals = {},
            }
            for _, d in ipairs(orig:GetChildren()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    table.insert(entry.decals, { inst = d, tr = d.Transparency })
                end
            end
            pcall(function() orig.Transparency = 1 end)
            pcall(function() orig.LocalTransparencyModifier = 1 end)
            for _, d in ipairs(orig:GetChildren()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    pcall(function() d.Transparency = 1 end)
                end
            end
            clone.Name = "ITSAvatarLimb_" .. orig.Name
            pcall(function() clone.CanCollide = false end)
            pcall(function() clone.Massless = true end)
            pcall(function() clone.Anchored = false end)
            pcall(function() clone.Transparency = 0 end)
            pcall(function() clone:SetAttribute("ITSAvatar", true) end)
            clone.CFrame = orig.CFrame
            clone.Parent = char
            local weld = Instance.new("Weld")
            weld.Name = "ITSAvatarLimbWeld"
            weld.Part0 = orig
            weld.Part1 = clone
            weld.C0 = CFrame.new()
            weld.C1 = CFrame.new()
            weld.Parent = clone
            table.insert(rec.limbs, entry)
            return true
        end

        FN.applyBodyPart = function(char, it, noTrack)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return false, "no character" end
            local objs = FN.loadAssetObjects(it.id)
            if not objs then return false, "asset could not be loaded" end
            local rec = { meshes = {}, limbs = {} }
            local applied, isR6 = 0, hum.RigType == Enum.HumanoidRigType.R6
            local hintUsed = false
            local sawClassicMesh = false

            -- classic path: CharacterMesh (only renders on R6 rigs)
            local mesh = FN.findInObjects(objs, "CharacterMesh")
            if mesh then
                sawClassicMesh = true
                if isR6 then
                    local okClone, clone = pcall(function() return mesh:Clone() end)
                    if okClone and clone then
                        clone.Name = "ITSAvatarBodyPart"
                        pcall(function() clone:SetAttribute("ITSAvatar", true) end)
                        clone.Parent = char
                        table.insert(rec.meshes, clone)
                        applied = applied + 1
                    end
                end
            end

            -- modern path: package MeshParts replace matching limbs
            local seen = {}
            for _, root in ipairs(objs) do
                local parts = {}
                if root:IsA("BasePart") then table.insert(parts, root) end
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("BasePart") then table.insert(parts, d) end
                end
                for _, src in ipairs(parts) do
                    if not seen[src] and src.Name ~= "HumanoidRootPart" and src.Name ~= "Handle" then
                        seen[src] = true
                        local orig = FN.matchCharPart(char, src.Name)
                        if not orig and it.slot and not hintUsed then
                            -- the catalog metadata says which limb this part
                            -- belongs to; trust it when the name doesn't match
                            local key = LIMB_MAP.slot[it.slot]
                            if key then
                                orig = FN.limbForKey(char, key)
                                if orig then hintUsed = true end
                            end
                        end
                        if orig then
                            local okClone, clone = pcall(function() return src:Clone() end)
                            if okClone and clone then
                                if FN.replaceLimbPart(char, orig, clone, rec) then
                                    applied = applied + 1
                                end
                            end
                        end
                    end
                end
            end
            FN.destroyObjects(objs)

            if applied == 0 then
                for _, m in ipairs(rec.meshes) do pcall(function() m:Destroy() end) end
                for _, e in ipairs(rec.limbs) do FN.restoreLimbEntry(e) end
                if sawClassicMesh and not isR6 then
                    return false, "this classic part only renders on R6 avatars"
                end
                return false, "this part doesn't fit your avatar's rig"
            end
            if not noTrack then
                wornBodyParts[it.id] = rec
            end
            return true, tostring(it.label or "body part") .. " applied"
        end

        FN.sweepBodyParts = function(char)
            if not char then return end
            for _, d in ipairs(char:GetChildren()) do
                local isMesh = d:IsA("CharacterMesh") and d.Name == "ITSAvatarBodyPart"
                local isLimb = d:IsA("BasePart")
                    and string.find(d.Name, "ITSAvatarLimb_", 1, true) == 1
                if isMesh or isLimb then
                    if isLimb then
                        local origName = string.gsub(d.Name, "^ITSAvatarLimb_", "")
                        local orig = char:FindFirstChild(origName)
                        if orig and orig:IsA("BasePart") then
                            pcall(function()
                                orig.Transparency = orig:GetAttribute("ITSLimbTr") or 0
                                orig.LocalTransparencyModifier = orig:GetAttribute("ITSLimbLtm") or 0
                                orig:SetAttribute("ITSLimbTr", nil)
                                orig:SetAttribute("ITSLimbLtm", nil)
                            end)
                            for _, dd in ipairs(orig:GetChildren()) do
                                if dd:IsA("Decal") or dd:IsA("Texture") then
                                    pcall(function() dd.Transparency = 0 end)
                                end
                            end
                        end
                    end
                    pcall(function() d:Destroy() end)
                end
            end
            wornBodyParts = {}
        end

        -- ===== per-item apply / unapply =====
        local wornInst = {}      -- [id] = Accessory instance we added
        local wornLayered = {}   -- [id] = bool (layered: no manual welds)

        FN.unapplyItem = function(it)
            if it.mode == "accessory" then
                local acc = wornInst[it.id]
                if acc then pcall(function() acc:Destroy() end) end
                wornInst[it.id] = nil
                wornLayered[it.id] = nil
            elseif it.mode == "shirt" then
                FN.revertClothing("Shirt")
            elseif it.mode == "pants" then
                FN.revertClothing("Pants")
            elseif it.mode == "tshirt" then
                FN.revertClothing("ShirtGraphic")
            elseif it.mode == "face" then
                FN.revertClothing("Face")
            elseif it.mode == "head" then
                FN.revertHeadSwap()
            elseif it.mode == "bodypart" then
                local rec = wornBodyParts[it.id]
                if rec then
                    for _, m in ipairs(rec.meshes or {}) do
                        pcall(function() m:Destroy() end)
                    end
                    for _, e in ipairs(rec.limbs or {}) do
                        FN.restoreLimbEntry(e)
                    end
                    wornBodyParts[it.id] = nil
                end
                FN.repairLimbs(LocalPlayer.Character)
            elseif it.mode == "gear" then
                for i = #ActiveGear, 1, -1 do
                    if ActiveGear[i].id == it.id then
                        pcall(function() ActiveGear[i].tool:Destroy() end)
                        table.remove(ActiveGear, i)
                    end
                end
            end
        end

        FN.applyItem = function(it)
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum then return false, "no character" end

            if it.mode == "accessory" then
                local objs = FN.loadAssetObjects(it.id)
                local acc = FN.findInObjects(objs, "Accessory")
                if not acc then
                    FN.destroyObjects(objs)
                    return false, "asset could not be loaded"
                end
                local okClone, clone = pcall(function() return acc:Clone() end)
                FN.destroyObjects(objs)
                if not okClone or not clone then return false, "clone failed" end
                -- mark as library-worn BEFORE attaching, so the headless V2
                -- ChildAdded sweep can never catch this accessory unmarked
                pcall(function() clone:SetAttribute("ITSAvatar", true) end)
                local okA, how = FN.attachAccessory(char, hum, clone, not it.layered)
                if okA and clone.Parent then
                    pcall(function() clone:SetAttribute("ITSAvatar", true) end)
                    wornInst[it.id] = clone
                    wornLayered[it.id] = it.layered and true or false
                    return true, how
                end
                pcall(function() clone:Destroy() end)
                return false, "could not attach"

            elseif it.mode == "shirt" or it.mode == "pants"
                or it.mode == "tshirt" or it.mode == "face" then
                local className = it.class
                if not className then
                    if it.mode == "tshirt" then className = "ShirtGraphic"
                    elseif it.mode == "face" then className = "Decal"
                    elseif it.mode == "shirt" then className = "Shirt"
                    else className = "Pants" end
                end
                local objs = FN.loadAssetObjects(it.id)
                local source = FN.findInObjects(objs, className)
                local ok, resolved = FN.applyClothing(char, source, it.id, className)
                FN.destroyObjects(objs)
                if ok then
                    return true, it.label .. (resolved and "" or " (texture unresolved)")
                end
                return false, "could not apply " .. tostring(it.label)

            elseif it.mode == "head" then
                return FN.applyHeadAsset(it.id, it.headType == "dynamic")

            elseif it.mode == "bodypart" then
                local char = LocalPlayer.Character
                if not char then return false, "no character" end
                return FN.applyBodyPart(char, it)

            elseif it.mode == "gear" then
                local ok = FN.equipGearItem(it)
                return ok, ok and "equipped tool" or "tool could not be loaded"
            end

            return false, "unsupported item"
        end

        reapplyAll = function()
            task.spawn(function()
                local char = LocalPlayer.Character
                if not char then return end
                if not State.base and not OriginalDescription then
                    FN.captureOriginal(false)
                end
                -- fresh character: reset instance tracking, sweep leftovers
                wornInst, wornLayered = {}, {}
                clothingBack = {}
                headSwapPart, headSwapBackup = nil, nil
                ActiveGear = {}
                for _, d in ipairs(char:GetChildren()) do
                    if d:IsA("Accessory") and d:GetAttribute("ITSAvatar") then
                        pcall(function() d:Destroy() end)
                    end
                end
                FN.cleanupStrayHeadSwaps(char)
                FN.sweepBodyParts(char)
                for _, it in ipairs(State.items) do
                    if LocalPlayer.Character ~= char then return end
                    pcall(FN.applyItem, it)
                    task.wait(0.1)
                end
            end)
        end

