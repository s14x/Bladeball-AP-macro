UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Config.Keybind then
        pcall(function() SpamToggle:SetValue(not Config.Spamming) end)
        saveConfig()
    end
    -- Triggerbot key is polled with UserInputService:IsKeyDown() every frame.
end)

-- ========== START ==========
if Config.Spamming then PlayParryAnimation() end

NZNotification.new("INFINITE TSUKUYOMI", "Loaded. Parry once to hook. " ..
    Config.Keybind.Name .. " = Tsukuyomi, hold " .. Config.TriggerBotKeybind.Name .. " = Triggerbot (HOLD)", 6)
print("[INFINITE TSUKUYOMI] loaded")
