        -- ===== HTTP (executor-agnostic, multi-endpoint fallback) =====
        local requestFn = nil
        local requestResolved = false
        FN.getRequestFn = function()
            if requestResolved then return requestFn end
            requestResolved = true
            if syn and syn.request then requestFn = syn.request
            elseif http_request then requestFn = http_request
            elseif http and http.request then requestFn = http.request
            elseif request then requestFn = request end
            return requestFn
        end

        local HTTP_HEADERS = {
            ["Accept"] = "application/json",
            ["Roblox-Place-Id"] = "",
            ["Roblox-Universe-Id"] = "",
        }

        FN.rawHttp = function(url)
            local req = FN.getRequestFn()
            if req then
                local ok, resp = pcall(req, { Url = url, Method = "GET", Headers = HTTP_HEADERS })
                if ok and type(resp) == "table" then
                    local status = resp.StatusCode or resp.status_code
                    local body = resp.Body or resp.body
                    if (not status or status < 400) and body and body ~= "" then return body end
                    if status and status >= 400 then return nil, "HTTP " .. tostring(status) end
                end
            end
            local okGet, body = pcall(function() return game:HttpGet(url, true) end)
            if okGet and type(body) == "string" and body ~= "" then return body end
            return nil, "no HTTP access"
        end

        -- pulls JSON out of a body that may be wrapped in proxy reader text
        FN.extractJson = function(body)
            if type(body) == "table" then return body end
            local text = tostring(body):gsub("^%s+", "")
            local first = string.sub(text, 1, 1)
            if first ~= "{" and first ~= "[" then
                local startPos = string.find(text, "{", 1, true)
                local _, endPos = string.find(text, "^.*}")
                if not (startPos and endPos and endPos > startPos) then
                    if first == "<" then return nil, "proxy returned HTML" end
                    return nil, "unreadable: " .. string.sub(text, 1, 40)
                end
                text = string.sub(text, startPos, endPos)
            end
            local ok, data = pcall(function() return HttpService:JSONDecode(text) end)
            if not ok or type(data) ~= "table" then
                return nil, "bad JSON: " .. string.sub(text, 1, 40)
            end
            return data
        end

        -- direct roblox.com is often blocked in-experience; proxies fetch
        -- server-side so no client header survives to be rejected
        local CATALOG_ENDPOINTS = {
            { url = function(host, path) return "https://" .. host .. ".roblox.com" .. path end },
            { url = function(host, path) return "https://" .. host .. ".roproxy.com" .. path end },
            { url = function(host, path) return "https://r.jina.ai/https://" .. host .. ".roproxy.com" .. path end },
            { url = function(host, path) return "https://api.allorigins.win/raw?url=" .. HttpService:UrlEncode("https://" .. host .. ".roproxy.com" .. path) end },
            { url = function(host, path) return "https://r.jina.ai/https://" .. host .. ".roblox.com" .. path end },
        }

        local bestEndpoint = nil
        local responseCache = {}

        FN.orderedEndpoints = function()
            local order = {}
            if bestEndpoint then table.insert(order, bestEndpoint) end
            for i = 1, #CATALOG_ENDPOINTS do
                if i ~= bestEndpoint then table.insert(order, i) end
            end
            return order
        end

        -- host: "catalog" or "economy"; sticky-routes to whichever endpoint
        -- answered last, so a search usually costs one request
        FN.httpGetJson = function(path, host)
            host = host or "catalog"
            local cacheKey = host .. path
            if responseCache[cacheKey] then return responseCache[cacheKey] end
            local lastErr = "no HTTP access"
            for _, idx in ipairs(FN.orderedEndpoints()) do
                local body, err = FN.rawHttp(CATALOG_ENDPOINTS[idx].url(host, path))
                if body then
                    local data, derr = FN.extractJson(body)
                    -- jina wraps the real payload in data.content when it
                    -- answers with its own envelope
                    if data and type(data.data) == "table" and type(data.data.content) == "string" then
                        local inner = FN.extractJson(data.data.content)
                        if inner then data = inner end
                    end
                    if data then
                        if data.errors then
                            local first = data.errors[1]
                            local msg = first and first.message or ""
                            lastErr = (msg ~= "" and msg) or "blocked by Roblox bot check"
                        else
                            bestEndpoint = idx
                            responseCache[cacheKey] = data
                            return data
                        end
                    else
                        lastErr = derr or "unreadable response"
                    end
                elseif err then
                    lastErr = err
                end
            end
            return nil, lastErr
        end

