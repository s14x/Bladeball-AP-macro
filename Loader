        local function setTab(id)
            for tid, t in pairs(TabButtons) do
                t.underline.Visible = (tid == id)
                t.btn.BackgroundColor3 = (tid == id)
                    and NeverZen.Theme.Hightlight or Color3.fromRGB(10,10,10)
                t.btn.TextColor3 = (tid == id)
                    and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
            end
            UI.PageAvatar.Visible = (id == "avatar")
            UI.PageWorld.Visible = (id == "world")
        end
        for tid, t in pairs(TabButtons) do
            t.btn.MouseButton1Click:Connect(function() setTab(tid) end)
        end

        FN.buildRail()
        FN.selectLibrary(LIBRARIES[1])
        setTab("avatar")

        -- ===== respawn handling =====
        LocalPlayer.CharacterAdded:Connect(function(newChar)
            OriginalDescription = nil
            ActiveGear = {}
            FN.stopSpin()
            spawnGeneration = spawnGeneration + 1
            local gen = spawnGeneration
            task.delay(2, function()
                if gen ~= spawnGeneration then return end
                if not OriginalDescription and not State.base and #State.items == 0 then
                    FN.captureOriginal(false)
                end
            end)
            if State.autoReapply and #State.items > 0 then
                task.spawn(function()
                    -- wait until fully spawned & settled; abort if the
                    -- player died / respawned again in the meantime
                    if not waitSpawnReady(newChar, 2.0) then return end
                    if gen ~= spawnGeneration or LocalPlayer.Character ~= newChar then return end
                    reapplyAll()
                    task.wait(0.3)
                    if gen == spawnGeneration and LocalPlayer.Character == newChar then
                        unstickCharacter(newChar)
                    end
                end)
            end
        end)

        if LocalPlayer.CharacterAppearanceLoaded then
            LocalPlayer.CharacterAppearanceLoaded:Connect(function()
                task.delay(0.5, function()
                    if not OriginalDescription and not State.base and #State.items == 0 then
                        FN.captureOriginal(false)
                    end
                end)
            end)
        end

        -- ===== auto-wear: re-apply the items worn in the last session =====
        do
            local byId = {}
            for _, lib in ipairs(LIBRARIES) do
                for _, r in ipairs(FN.libraryRecords(lib)) do
                    if not byId[r.id] then byId[r.id] = r end
                end
            end
            for idStr in string.gmatch(Config.AvatarWorn or "", "[^,]+") do
                local id = tonumber(idStr)
                if id and byId[id] and not FN.isWorn(id) then
                    table.insert(State.items, byId[id])
                end
            end
            if #State.items > 0 then
                FN.refreshCards()
                if State.autoReapply and LocalPlayer.Character then
                    local ch = LocalPlayer.Character
                    spawnGeneration = spawnGeneration + 1
                    local gen = spawnGeneration
                    task.spawn(function()
                        if not waitSpawnReady(ch, 1.5) then return end
                        if gen ~= spawnGeneration or LocalPlayer.Character ~= ch then return end
                        reapplyAll()
                        unstickCharacter(ch)
                    end)
                end
            end
        end

        table.insert(NeverZen.Cleanups, FN.stopSpin)

        local Studio = {}
        function Studio.Open()
            if not UI.ScreenGui.Enabled then
                UI.ScreenGui.Enabled = true
                if not OriginalDescription and not State.base and #State.items == 0 then
                    FN.captureOriginal(false)
                end
                FN.selectLibrary(CurrentLib)
            else
                UI.ScreenGui.Enabled = false
                FN.stopSpin()
            end
        end
        function Studio.SetAutoReapply(v)
            State.autoReapply = v and true or false
            Config.AvatarAutoReapply = State.autoReapply
            saveConfig()
        end
        return Studio
    end









    function NeverZen:Unload()
        for i,v in next, NeverZen.Cleanups do pcall(v) end
        table.clear(NeverZen.Cleanups)
        for i,v in next, NeverZen.Connections do pcall(function() v:Disconnect() end) end
        table.clear(NeverZen.Connections)
        for i,v in next, NeverZen.Guis do pcall(function() v:Destroy() end) end
        table.clear(NeverZen.Guis)
    end
end

