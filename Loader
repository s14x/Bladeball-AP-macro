                end

                local favCorner = Instance.new("UICorner")
                favCorner.CornerRadius = UDim.new(0,4)
                favCorner.Parent = FavBtn
                local favStroke = Instance.new("UIStroke")
                favStroke.Color = isFav and Color3.fromRGB(120,100,40) or Color3.fromRGB(55,55,55)
                favStroke.Parent = FavBtn

                Row.MouseEnter:Connect(function()
                    showHoverPanel(sword, Row)
                end)
                Row.MouseLeave:Connect(function()
                    hideHoverPanel(sword)
                end)

                NameBtn.MouseEnter:Connect(function()
                    Row.BackgroundColor3 = Color3.fromRGB(30,30,30)
                end)
                NameBtn.MouseLeave:Connect(function()
                    Row.BackgroundColor3 = Color3.fromRGB(12,12,12)
                end)
                NameBtn.MouseButton1Click:Connect(function()
                    if onPickCallback then pcall(onPickCallback, sword) end
                    ScreenGui.Enabled = false
                end)

                FavBtn.MouseEnter:Connect(function()
                    FavBtn.BackgroundColor3 = isFav and Color3.fromRGB(80,68,30) or Color3.fromRGB(50,50,50)
                end)
                FavBtn.MouseLeave:Connect(function()
                    FavBtn.BackgroundColor3 = isFav and Color3.fromRGB(60,50,20) or Color3.fromRGB(30,30,30)
                end)
                FavBtn.MouseButton1Click:Connect(function()
                    ToggleFavorite(sword)
                end)

                table.insert(rows, Row)
            end

            if count == 0 then
                EmptyLabel.Visible = true
                if currentTab == "favorites" then
                    if searchFilter ~= "" then
                        EmptyLabel.Text = "No favorites match \"" .. searchFilter .. "\""
                    elseif catFilter then
                        EmptyLabel.Text = "No favorites in category [" .. tostring(catFilter) ..
                            "]\nGo to 'All Swords' and click Favorite on a sword first."
                    else
                        EmptyLabel.Text = "No favorites yet.\nSwitch to 'All Swords' and click 'Favorite' on any sword."
                    end
                else
                    if searchFilter ~= "" then
                        EmptyLabel.Text = "No results for \"" .. searchFilter .. "\""
                    elseif catFilter then
                        EmptyLabel.Text = "No swords found in category [" .. tostring(catFilter) .. "]"
                    else
                        EmptyLabel.Text = "No swords"
                    end
                end
            else
                EmptyLabel.Visible = false
            end

            -- kick off lazy picture loading for the visible rows
            task.delay(0.1, scheduleVisiblePreviews)
            updateCanvas()
        end

