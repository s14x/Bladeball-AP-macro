        local function ensureRowPreview(sword)
            local holder = rowsByName[sword]
            if not holder or not holder.Parent then return end
            local cached = SwordPreview.Peek(sword)
            if cached then
                if cached.Parent ~= holder then cached.Parent = holder end
                return
            end
            if rowRequested[sword] then return end
            rowRequested[sword] = true
            SwordPreview.Request(sword, function(obj)
                if obj then
                    local h = rowsByName[sword]
                    if h and h.Parent then obj.Parent = h end
                else
                    rowRequested[sword] = nil
                end
            end)
        end

        local function showHoverPanel(sword, row)
            hoverSword = sword
            HoverName.Text = sword
            HoverInitials.Text = swordInitials(sword)

            local tag = SWORD_TAGS[sword]
            local cat = GetSwordCategory(sword)
            local pieces = {}
            if tag then
                local color = TAG_COLORS[tag] or "#ffffff"
                table.insert(pieces, "<font color=\"" .. color .. "\"><b>" .. tag .. "</b></font>")
            end
            if cat then table.insert(pieces, tostring(cat)) end
            HoverTag.Text = table.concat(pieces, "  •  ")

            ensureRowPreview(sword)
            clearHoverClone()
            local cached = SwordPreview.Peek(sword)
            if cached then
                local cl = SwordPreview.Clone(sword)
                if cl then
                    cl.ZIndex = 33
                    cl.Parent = HoverPicBox
                    hoverClone = cl
                end
            else
                SwordPreview.Request(sword, function(obj)
                    if hoverSword ~= sword or not obj then return end
                    local cl = SwordPreview.Clone(sword)
                    if cl then
                        cl.ZIndex = 33
                        cl.Parent = HoverPicBox
                        hoverClone = cl
                    end
                end)
            end

            -- place the panel next to the window, clamped to the screen
            local vs = Vector2.new(1920, 1080)
            pcall(function()
                local cam = Workspace.CurrentCamera
                if cam then vs = cam.ViewportSize end
            end)
            local px = Frame.AbsolutePosition.X + Frame.AbsoluteSize.X + 12
            local py = row.AbsolutePosition.Y - 40
            if py < 60 then py = 60 end
            if px + 200 > vs.X then px = vs.X - 202 end
            if py + 240 > vs.Y then py = vs.Y - 242 end
            HoverPanel.Position = UDim2.new(0, px, 0, py)
            HoverPanel.Visible = true
        end

        -- lazy loading: only build pictures for rows that are
        -- actually on screen (+ a little margin)
        local previewScanQueued = false
        local function scheduleVisiblePreviews()
            if previewScanQueued then return end
            previewScanQueued = true
            task.defer(function()
                previewScanQueued = false
                if not ScreenGui.Enabled then return end
                local canvasTop = Scroller.CanvasPosition.Y - 120
                local canvasBottom = Scroller.CanvasPosition.Y + Scroller.AbsoluteWindowSize.Y + 120
                for sword, holder in pairs(rowsByName) do
                    if holder.Parent then
                        local y = holder.AbsolutePosition.Y - Scroller.AbsolutePosition.Y + Scroller.CanvasPosition.Y
                        if y + 40 >= canvasTop and y <= canvasBottom then
                            ensureRowPreview(sword)
                        end
                    end
                end
            end)
        end

