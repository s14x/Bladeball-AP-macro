local _swordModule = nil
local _swordModuleOK = false
pcall(function()
    local swordsFolder = ReplicatedStorage:WaitForChild("Shared", 15)
        :WaitForChild("ReplicatedInstances", 15)
        :WaitForChild("Swords", 15)
    _swordModule = require(swordsFolder)
    _swordModuleOK = true
end)

-- "giveable" dev copies of exclusive swords have no VFX: any request for
-- one resolves to the real version instead
local SWORD_ALIAS = {
    ["giveable champ"] = "Champion Scythe",
}

local function FindRealSwordName(input)
    if type(input) ~= "string" or input == "" then return nil end
    local alias = SWORD_ALIAS[input:lower()]
    if alias then input = alias end
    local hit = SWORD_LOOKUP[input:lower()]
    if hit then return hit end
    local lowerInput = input:lower()
    for _, name in ipairs(SORTED_SWORDS) do
        if name:lower():find(lowerInput, 1, true) then
            return name
        end
    end
    if _swordModuleOK and _swordModule then
        local ok, result = pcall(function() return _swordModule:GetSword(input) end)
        if ok and result and type(result) == "table" then
            return input
        end
    end
    return nil
end

-- ============================================================
-- SWORD PICTURES (a picture for every sword in the changer)
-- Every sword gets a small 3D thumbnail rendered inside a
-- ViewportFrame, using the game's own sword model. Pictures
-- are built lazily (only for rows you can actually see) and
-- cached, so a 1500+ sword list stays perfectly smooth.
-- While a picture is loading (or if a sword can't be
-- resolved), the slot shows the sword's initials instead.
-- ============================================================
local function swordInitials(name)
    local n = tostring(name or "")
    if n == "" then return "?" end
    local parts = {}
    for word in n:gmatch("%S+") do
        local f = word:sub(1, 1)
        if f:match("%w") then table.insert(parts, f:upper()) end
        if #parts >= 2 then break end
    end
    if #parts == 0 then
        return n:sub(1, 2):upper()
    elseif #parts == 1 then
        local squished = n:gsub("%s+", "")
        local second = squished:sub(2, 2)
        if second:match("%w") then table.insert(parts, second:upper()) end
    end
    return table.concat(parts, "")
end

local SwordPreview = {}
do
    local MAX_CACHE     = 400   -- finished previews kept around
    local MAX_QUEUE     = 500   -- pending build requests
    local REMOTE_BUDGET = 250   -- GetSword remote fallback call limit

    local cache     = {}  -- [swordName] = ViewportFrame / ImageLabel
    local state     = {}  -- [swordName] = "queued" | "building" | "done" | "failed"
    local order     = {}  -- finish order, used to trim the cache
    local queue     = {}  -- names waiting to be built
    local callbacks = {}  -- [swordName] = { fn, ... }
    local moduleDataCache  = {}  -- [swordName] = data | false (module lookups only)
    local remoteDataCache  = {}  -- [swordName] = data | false (after remote fallback)
    local nameResolveCache = {}  -- [listName] = game name accepted by the module
    local searchFolders = nil
    local pumping = false

    -- Name variants: the in-game name sometimes differs slightly from our
    -- list (apostrophes, a trailing "Sword", ...). Every lookup tries these
    -- in order until one resolves — this is what keeps the pictures working
    -- for renamed swords (e.g. ranked Top 1 swords now being "… Sword").
    local function swordNameVariants(swordName)
        local list = { swordName }
        table.insert(list, swordName .. " Sword")
        local v = swordName:gsub("(%a)s(%s)", "%1's%2")
        if v ~= swordName then table.insert(list, v) end
        v = swordName:gsub("'", "")
        if v ~= swordName then table.insert(list, v) end
        return list
    end

    local function tryModuleGetSword(name)
        if not (_swordModuleOK and _swordModule) then return nil end
        local ok, data = pcall(function() return _swordModule:GetSword(name) end)
        if ok and (type(data) == "table" or typeof(data) == "Instance") then
            return data
        end
        return nil
    end

    -- which variant of a sword name the game's module actually accepts
    local function resolveGameName(swordName)
        if nameResolveCache[swordName] ~= nil then return nameResolveCache[swordName] end
        local resolved = nil
        for _, variant in ipairs(swordNameVariants(swordName)) do
            if tryModuleGetSword(variant) then
                resolved = variant
                break
            end
        end
        nameResolveCache[swordName] = resolved or false
        return resolved
    end

    -- Folders that plausibly hold sword models, in case the sword
    -- data doesn't point at the model directly.
    local function getSearchFolders()
        if searchFolders then return searchFolders end
        searchFolders = {}
        local function walk(parent, depth)
            if depth > 4 then return end
            for _, ch in ipairs(parent:GetChildren()) do
                if ch:IsA("Folder") or ch:IsA("ModuleScript") then
                    local low = ch.Name:lower()
                    if low == "swords" or low == "swordmodels" or low == "weapons" then
                        table.insert(searchFolders, ch)
                    end
                    walk(ch, depth + 1)
                end
            end
        end
        pcall(walk, ReplicatedStorage, 0)
        return searchFolders
    end

    local function querySwordData(swordName, allowRemote)
        if allowRemote then
            if remoteDataCache[swordName] ~= nil then return remoteDataCache[swordName] end
        else
            if moduleDataCache[swordName] ~= nil then return moduleDataCache[swordName] end
        end
        local result = nil
        -- local module first (free, instant), trying name variants so
        -- renamed swords still resolve
        for _, variant in ipairs(swordNameVariants(swordName)) do
            local data = tryModuleGetSword(variant)
            if data then
                result = data
                nameResolveCache[swordName] = variant
                break
            end
        end
        if result then
            moduleDataCache[swordName] = result
            remoteDataCache[swordName] = result
            return result
        end
        moduleDataCache[swordName] = false
        if not allowRemote then return nil end
        -- remote fallback (budgeted so we never spam it)
        pcall(function()
            if REMOTE_BUDGET <= 0 then return end
            local rfOk, rf = pcall(function()
                return ReplicatedStorage.Shared.ReplicatedInstances.Swords:FindFirstChild("GetSword")
            end)
            if not (rfOk and rf and rf:IsA("RemoteFunction")) then return end
            local tries = 0
            for _, variant in ipairs(swordNameVariants(swordName)) do
                if REMOTE_BUDGET <= 0 or tries >= 2 then break end
                tries = tries + 1
                REMOTE_BUDGET = REMOTE_BUDGET - 1
                local ok, data = pcall(rf.InvokeServer, rf, variant)
                if ok and (type(data) == "table" or typeof(data) == "Instance") then
                    result = data
                    nameResolveCache[swordName] = variant
                    break
                end
            end
        end)
        remoteDataCache[swordName] = result or false
        return result
    end

    local function extractModel(data)
        if type(data) ~= "table" then return nil end
        for _, key in ipairs({"Model", "model", "SwordModel", "Sword", "Weapon", "Handle"}) do
            local v = data[key]
            if typeof(v) == "Instance" and (v:IsA("Model") or v:IsA("BasePart")) then
                return v
            end
        end
        return nil
    end

    local function looksLikeAsset(s)
        if type(s) ~= "string" or #s < 6 then return false end
        if s:find("rbxassetid", 1, true) then return true end
        if s:find("rbxthumb", 1, true) then return true end
        if s:find("http", 1, true) then return true end
        return false
    end

    local function extractIcon(data)
        if type(data) ~= "table" then return nil end
        for _, key in ipairs({"Icon", "icon", "Image", "Thumbnail", "Texture"}) do
            local v = data[key]
            if looksLikeAsset(v) then return v end
        end
        return nil
    end

    -- renders a model template into a framed ViewportFrame thumbnail
    local function buildViewport(template)
        local ok, vp = pcall(function()
            local v = Instance.new("ViewportFrame")
            v.Size = UDim2.new(1, 0, 1, 0)
            v.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            v.BackgroundTransparency = 0
            v.BorderSizePixel = 0
            v.ZIndex = 6
            v.Ambient = Color3.fromRGB(140, 140, 140)
            v.LightColor = Color3.fromRGB(255, 255, 255)
            v.LightDirection = Vector3.new(-1, -1, -2)

            local world = Instance.new("WorldModel")
            world.Parent = v

            local clone = template:Clone()
            if not clone then
                -- some games mark models non-archivable to block cloning
                local wasArchivable = template.Archivable
                pcall(function() template.Archivable = true end)
                clone = template:Clone()
                pcall(function() template.Archivable = wasArchivable end)
            end
            if not clone then return nil end
            if clone:IsA("BasePart") then
                clone.Anchored = true
                clone.CanCollide = false
            end
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                elseif d:IsA("BaseScript") or d:IsA("Sound") then
                    d:Destroy()
                elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail")
                    or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                    d.Enabled = false
                end
            end

            local bbCFrame, bbSize
            if clone:IsA("Model") then
                bbCFrame, bbSize = clone:GetBoundingBox()
            else
                bbCFrame, bbSize = clone.CFrame, clone.Size
            end
            -- center it at the origin (keeps its own orientation)
            clone:PivotTo(bbCFrame)
            -- long vertical blades get tilted onto a diagonal
            if bbSize.Y > bbSize.X * 1.4 and bbSize.Y > bbSize.Z * 1.4 then
                clone:PivotTo(bbCFrame * CFrame.Angles(0, math.rad(20), math.rad(-35)))
            end
            clone.Parent = world

            local maxDim = math.max(bbSize.X, bbSize.Y, bbSize.Z)
            if not (maxDim > 0) then maxDim = 1 end

            local cam = Instance.new("Camera")
            cam.FieldOfView = 40
            local dist = (maxDim * 0.5) / math.sin(math.rad(20)) * 1.08
            local dir = Vector3.new(1, 0.45, 1).Unit
            cam.CFrame = CFrame.lookAt(dir * dist, Vector3.new(0, 0, 0))
            cam.Parent = v
            v.CurrentCamera = cam
            return v
        end)
        if ok and vp then return vp end
        return nil
    end

    -- if the game ships 2D icons for swords, use those instead
    local function buildIcon(image)
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(1, -4, 1, -4)
        img.Position = UDim2.new(0, 2, 0, 2)
        img.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        img.BackgroundTransparency = 0
        img.BorderSizePixel = 0
        img.ZIndex = 6
        img.Image = image
        img.ScaleType = Enum.ScaleType.Fit
        return img
    end

    -- some games expose the model through a getter function instead of the
    -- data table — probe for Get*Model* / Get*View* style module functions
    local function probeModuleForModel(swordName)
        if not (_swordModuleOK and type(_swordModule) == "table") then return nil end
        for k, v in pairs(_swordModule) do
            if type(v) == "function" and type(k) == "string" then
                local lk = k:lower()
                if lk:sub(1, 3) == "get" and (lk:find("model", 1, true) or lk:find("view", 1, true)) then
                    local ok, res = pcall(v, swordName)
                    if ok and typeof(res) == "Instance" and (res:IsA("Model") or res:IsA("BasePart")) then
                        return res
                    end
                end
            end
        end
        return nil
    end

    local function buildPreviewObject(swordName)
        local data = querySwordData(swordName, true)
        if data and typeof(data) == "Instance" then
            if data:IsA("Model") or data:IsA("BasePart") then
                return buildViewport(data)
            end
            return nil
        end
        local model = extractModel(data)
        if model then return buildViewport(model) end
        local icon = extractIcon(data)
        if icon then return buildIcon(icon) end
        -- probe the module's getter functions (with name variants)
        for _, variant in ipairs(swordNameVariants(swordName)) do
            local m = probeModuleForModel(variant)
            if m then return buildViewport(m) end
        end
        -- last resort: look for a model folder we know about
        for _, folder in ipairs(getSearchFolders()) do
            for _, variant in ipairs(swordNameVariants(swordName)) do
                local m = folder:FindFirstChild(variant)
                if m and (m:IsA("Model") or m:IsA("BasePart")) then
                    return buildViewport(m)
                end
            end
        end
        return nil
    end

    local function trimCache()
        local i = 1
        while #order > MAX_CACHE and i <= #order do
            local name = order[i]
            local obj = cache[name]
            if obj and obj.Parent == nil then
                table.remove(order, i)
                cache[name] = nil
                state[name] = nil
                obj:Destroy()
            else
                i = i + 1
            end
        end
    end

    -- one build per heartbeat, so the UI never hitches
    local function pump()
        if pumping then return end
        pumping = true
        task.spawn(function()
            while true do
                -- keep the queue bounded (fast scrolling enqueues a lot)
                while #queue > MAX_QUEUE do
                    local name = table.remove(queue, 1)
                    if name then
                        if state[name] == "queued" then state[name] = nil end
                        local cbs = callbacks[name]
                        callbacks[name] = nil
                        if cbs then
                            for _, cb in ipairs(cbs) do pcall(cb, nil) end
                        end
                    end
                end
                local name = table.remove(queue, 1)
                if not name then break end
                if state[name] == "queued" then
                    state[name] = "building"
                    local obj = nil
                    pcall(function() obj = buildPreviewObject(name) end)
                    local cbs = callbacks[name]
                    callbacks[name] = nil
                    if obj then
                        cache[name] = obj
                        state[name] = "done"
                        table.insert(order, name)
                        trimCache()
                        if cbs then
                            for _, cb in ipairs(cbs) do pcall(cb, obj) end
                        end
                    else
                        state[name] = "failed"
                        -- allow a retry later (module still loading,
                        -- remote busy, etc.)
                        task.delay(30, function()
                            if state[name] == "failed" then state[name] = nil end
                        end)
                        if cbs then
                            for _, cb in ipairs(cbs) do pcall(cb, nil) end
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
            pumping = false
        end)
    end

    function SwordPreview.Peek(swordName)
        return cache[swordName]
    end

    -- full data lookup (module + budgeted remote fallback) — for previews
    function SwordPreview.GetData(swordName)
        return querySwordData(swordName, true)
    end

    -- module-only lookup (safe for big sweeps, never touches remotes)
    function SwordPreview.GetModuleData(swordName)
        return querySwordData(swordName, false)
    end

    -- returns the exact name the game's sword module accepts (falls back
    -- to the given name if nothing resolves)
    function SwordPreview.ResolveName(swordName)
        local resolved = resolveGameName(swordName)
        if resolved then return resolved end
        return swordName
    end

    function SwordPreview.Request(swordName, callback)
        local obj = cache[swordName]
        if obj then
            if type(callback) == "function" then pcall(callback, obj) end
            return
        end
        if state[swordName] == "failed" then
            if type(callback) == "function" then pcall(callback, nil) end
            return
        end
        if type(callback) == "function" then
            callbacks[swordName] = callbacks[swordName] or {}
            table.insert(callbacks[swordName], callback)
        end
        if state[swordName] == nil then
            state[swordName] = "queued"
            table.insert(queue, swordName)
            pump()
        end
    end

    -- detaches a cached preview from a row holder before the row
    -- gets destroyed, so the preview survives list rebuilds
    function SwordPreview.Detach(swordName, holder)
        local obj = cache[swordName]
        if obj and holder and obj.Parent == holder then
            obj.Parent = nil
        end
    end

    -- returns an independent clone (used by the big hover preview)
    function SwordPreview.Clone(swordName)
        local obj = cache[swordName]
        if not obj then return nil end
        local ok, cl = pcall(function() return obj:Clone() end)
        if not ok or not cl then return nil end
        if cl:IsA("ViewportFrame") then
            local cam = cl:FindFirstChildOfClass("Camera")
            if cam then cl.CurrentCamera = cam end
        end
        cl.Position = UDim2.new(0, 0, 0, 0)
        cl.Size = UDim2.new(1, 0, 1, 0)
        return cl
    end
end

