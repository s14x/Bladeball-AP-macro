local _token = nil
local _tokenFound = false

task.defer(function()
    pcall(function()
        if not getgc then return end
        for _, fn in getgc(true) do
            if type(fn) == "function" then
                local ok, src = pcall(debug.info, fn, "s")
                if ok and src and src:find("PRY", 1, true) then
                    if getupvalues then
                        local ok2, ups = pcall(getupvalues, fn)
                        if ok2 and type(ups) == "table" then
                            for _, v in pairs(ups) do
                                if type(v) == "function" then
                                    _token = v
                                    _tokenFound = true
                                    break
                                end
                            end
                        end
                    end
                end
            end
            if _tokenFound then break end
        end
    end)
    task.wait(1)
    if _tokenFound then
        print("[ENGINE] Token ready — parry once to hook remote")
    else
        warn("[ENGINE] Token not found — rejoin recommended")
    end
end)

local function _tokenize(uid)
    local time_str = tostring(math.floor(Workspace:GetServerTimeNow() * 100))
    local key = _token(uid, "TIME")
    local chars = table.create(#time_str)
    for i = 1, #time_str do
        chars[i] = string.char(bit32.bxor((string.byte(time_str, i) + i) % 256, string.byte(key, (i - 1) % #key + 1)))
    end
    return table.concat(chars)
end

