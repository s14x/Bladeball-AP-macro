        -- ===== weld watchdog =====
        -- re-attaches accessories whose welds died or that drifted off the
        -- body, and keeps the real head hidden under a head swap
        do
            local acc_t = 0
            local watchdogConn = RunService.Heartbeat:Connect(function(dt)
                acc_t = acc_t + dt
                if acc_t < 0.5 then return end
                acc_t = 0

                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not char or not hum then return end
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")

                for id, accInst in pairs(wornInst) do
                    if accInst and accInst.Parent then
                        local h = accInst:FindFirstChild("Handle")
                        if h then
                            local drifted = root and (h.Position - root.Position).Magnitude > 30
                            if not FN.hasLiveWeld(h) or drifted then
                                pcall(FN.attachAccessory, char, hum, accInst, wornLayered[id] == false)
                            end
                        end
                    else
                        wornInst[id] = nil
                        wornLayered[id] = nil
                    end
                end

                local b = headSwapBackup
                if b and b.part and b.part.Parent then
                    pcall(function() b.part.Transparency = 1 end)
                end
            end)
            table.insert(NeverZen.Cleanups, function()
                pcall(function() watchdogConn:Disconnect() end)
            end)
        end

