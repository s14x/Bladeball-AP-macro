-- ============================================================
local AutoParry_Divisor = 1.1
local function updateDivisor()
    local acc = Config.AutoParryAccuracy or 100
    AutoParry_Divisor = 0.7 + (acc - 1) * (0.9/99)
end
updateDivisor()

local function CalcParryAccuracy(zoomies)
    local ping = GetPing() / 10
    local ping_threshold = math.clamp(ping / 10, 5, 17)
    local speed = zoomies.VectorVelocity.Magnitude
    local capped = math.min(math.max(speed - 9.5, 0), 650)
    local speed_divisor = (2.4 + capped * 0.002) * AutoParry_Divisor
    return ping_threshold + math.max(speed / speed_divisor, 9.5)
end

