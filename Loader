-- ============================================================
local function GetParryData()
    local PlayerPositions = {}
    local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    local MousePos
    if not isMobile then
        MousePos = {Mouse.X, Mouse.Y}
    else
        local vp = Workspace.CurrentCamera.ViewportSize
        MousePos = {vp.X / 2, vp.Y / 2}
    end

    local isInLobbyTraining = LocalPlayer:GetAttribute("LobbyTraining")
        and LocalPlayer.Character
        and LocalPlayer.Character.Parent == Workspace.Dead

    if isInLobbyTraining then
        local dead = Workspace:FindFirstChild("Dead")
        if dead then
            for _, pc in ipairs(dead:GetChildren()) do
                local p = Players:GetPlayerFromCharacter(pc)
                if p and p:GetAttribute("LobbyTraining") and pc.PrimaryPart then
                    PlayerPositions[pc.Name] = Workspace.CurrentCamera:WorldToScreenPoint(pc.PrimaryPart.Position)
                end
            end
        end
        for _, target in CollectionService:GetTagged("LobbyTrainingTarget") do
            PlayerPositions[target.Name] = Workspace.CurrentCamera:WorldToScreenPoint(target.Position)
        end
    else
        local alive = Workspace:FindFirstChild("Alive")
        if alive then
            for _, entity in ipairs(alive:GetChildren()) do
                if entity.PrimaryPart then
                    PlayerPositions[entity.Name] = Workspace.CurrentCamera:WorldToScreenPoint(entity.PrimaryPart.Position)
                end
            end
        end
    end

    local camCF = Workspace.CurrentCamera.CFrame
    local clashing, clashBall = IsClashing()
    if clashing and clashBall then
        camCF = CFrame.new(camCF.Position, clashBall.Position)
    end

    return { CFrame = camCF, Positions = PlayerPositions, Mouse = MousePos }
end

local function ShouldFireLegit()
    if Config.ParryMethod ~= "Legit" then return true end
    local ch = GetCharacter()
    if not ch or not ch.PrimaryPart then return false end
    local bf = Workspace:FindFirstChild("Balls")
    if not bf then return false end
    for _, b in ipairs(bf:GetChildren()) do
        if b:GetAttribute("realBall") then
            if b:GetAttribute("target") == LocalPlayer.Name then return true end
            local okd, dist = pcall(function() return (ch.PrimaryPart.Position - b.Position).Magnitude end)
            if okd and dist < 65 then return true end
        end
    end
    return false
end

-- ============================================================
-- SHARED ACCURACY
-- ============================================================
local AutoParry_Divisor = 1.1
local function updateDivisor()
    local acc = Config.AutoParryAccuracy or 100
    AutoParry_Divisor = 0.7 + (acc - 1) * (0.9/99)
end
updateDivisor()

local function CalcParryAccuracy(zoomies)
    local ping = GetPing() / 10
    local ping_threshold = math.clamp(ping / 10, 5, 17)
    local speed = zoomies.VectorVelocity.Magnitude
    local capped = math.min(math.max(speed - 9.5, 0), 650)
    local speed_divisor = (2.4 + capped * 0.002) * AutoParry_Divisor
    return ping_threshold + math.max(speed / speed_divisor, 9.5)
end

-- ---- per-frame caches (reset once per frame, reused by all FireParry calls) ----
local _frameParryData  = nil
local _frameShouldFire = nil
local _frameBlockOk    = nil
local _frameToken      = nil

local function _resetFrameCaches()
    _frameParryData  = nil
    _frameShouldFire = nil
    _frameBlockOk    = nil
    _frameToken      = nil
end

-- ============================================================
-- FIRE + GATES (uses per-frame caches)
-- ============================================================
local function fireParryRemote(data)
    if not _capturedRemote or not _capturedArgs or not _tokenFound or not _token then return false end
    local token = _frameToken
    if not token then
        local okTok, t = pcall(_tokenize, _capturedArgs[2])
        if not okTok or not t or t == "" then return false end
        token = t
        _frameToken = token
    end
    pcall(function()
        _capturedRemote:FireServer(_capturedArgs[1], _capturedArgs[2], token, 0.5, data.CFrame, data.Positions, data.Mouse, false)
    end)
    return true
end

local function FireParry()
    -- safe-mode gate (cached per frame)
    if Config.SafeMode then
        if _frameBlockOk == nil then _frameBlockOk = IsBlockLegit() end
        if not _frameBlockOk then return false end
    end

    -- legit-method gate (cached per frame)
    if Config.ParryMethod == "Legit" then
        if _frameShouldFire == nil then _frameShouldFire = ShouldFireLegit() end
        if not _frameShouldFire then return false end
    end

    -- parry payload (cached per frame)
    if not _frameParryData then _frameParryData = GetParryData() end
    return fireParryRemote(_frameParryData)
end

