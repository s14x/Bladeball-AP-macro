    if Config.Spamming then return end
    if not _capturedRemote then return end
    local char = GetCharacter()
    if not char or not char.PrimaryPart then return end
    if Config.SafeMode and not IsBlockLegit() then return end
    if char.PrimaryPart:FindFirstChild("SingularityCape") then return end
    if Config.TriggerBotInfinityDetection and InfinityFlag then return end

    local balls = System.ball.get_all()
    for _, ball in pairs(balls) do
        if not ball or not ball.Parent then continue end
        local zoomies = ball:FindFirstChild("zoomies")
        if not zoomies then continue end

        if ball:GetAttribute("target") ~= LocalPlayer.Name then continue end
        if ball:FindFirstChild("ComboCounter") then continue end

        local td = TBTriggerData[ball]
        if not td then
            td = { Triggered = false }
            TBTriggerData[ball] = td
            ball:GetAttributeChangedSignal("target"):Connect(function()
                td.Triggered = false
            end)
        end

        if td.Triggered then continue end

        local distance = (char.PrimaryPart.Position - ball.Position).Magnitude
        -- TriggerBotDistance: 1x = original range, up to 1.5x for a wider
        -- / earlier trigger window (slider in the Triggerbot tab)
        local parry_accuracy = CalcParryAccuracy(zoomies) * (Config.TriggerBotDistance or 1)

        if distance <= parry_accuracy then
            td.Triggered = true
            -- fire first; only play the local animation if the remote
            -- actually went through (no ghost anims when the hook/token
            -- isn't ready or a gate blocked the fire)
            local fired = FireParry()
            if fired then
                _tbLastFire = os.clock()
                if Config.TriggerBotAnimationFix then
                    PlaySingleParryAnimation()
                end
            end
            break
        end
    end
end)

