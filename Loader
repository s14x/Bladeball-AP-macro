        -- Resolve the "real" sword name with fallbacks, in case
        -- the tracked global hasn't been set yet for any reason.
        local function resolveRealSwordName()
            local cached = getgenv().realEquippedSword
            if cached and cached ~= "" then return cached end
            local att = LocalPlayer:GetAttribute("CurrentlyEquippedSword")
            if att and att ~= "" then
                getgenv().realEquippedSword = att
                return att
            end
            local char = LocalPlayer.Character
            if char then
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("Model") then
                        local hit = SWORD_LOOKUP[v.Name:lower()]
                        if hit then
                            getgenv().realEquippedSword = hit
                            return hit
                        end
                    end
                end
            end
            return nil
        end

        Rebuild = function(searchFilter)
            hideHoverPanel()
            -- detach cached pictures first so they survive the row destroy
            for sword, holder in pairs(rowsByName) do
                SwordPreview.Detach(sword, holder)
            end
            for _, r in ipairs(rows) do r:Destroy() end
            rows = {}
            rowsByName = {}
            rowRequested = {}
            searchFilter = searchFilter and searchFilter:lower() or ""

            local safeModeOn  = Config.SafeSwordChanger and true or false
            local realSword   = resolveRealSwordName()
            local realCat     = (realSword and realSword ~= "") and GetSwordCategory(realSword) or nil
            -- Only enforce a category filter when Safe Mode is ON *and* we
            -- know the real sword's category. If Safe Mode is OFF, catFilter
            -- is nil, so every sword is allowed.
            local catFilter   = (safeModeOn and realCat) or nil

            if not safeModeOn then
                FilterTag.Text = "FILTER OFF — all swords"
                FilterTag.TextColor3 = Color3.fromRGB(255,180,120)
            elseif catFilter then
                FilterTag.Text = "FILTER: " .. tostring(catFilter)
                FilterTag.TextColor3 = Color3.fromRGB(130,255,150)
            else
                FilterTag.Text = "FILTER: pending (no real sword)"
                FilterTag.TextColor3 = Color3.fromRGB(230,220,110)
            end

            local candidates = {}
            local totalPassedFilter = 0

            for _, sword in ipairs(SWORD_LIST) do
                -- Category gate: enforce strictly when Safe Mode is ON
                local catOK = true
                if catFilter then
                    local sc = GetSwordCategory(sword)
                    catOK = (sc ~= nil and sc == catFilter)
                end

                -- Favorites gate
                local favOK = true
                if currentTab == "favorites" then
                    favOK = (Favorites[sword] == true)
                end

                -- Search gate (applies on top of category filter)
                local searchOK = true
                if searchFilter ~= "" then
                    local low = sword:lower()
                    local tag = SWORD_TAGS[sword]
                    local tagLow = tag and tag:lower() or ""
                    local p1 = low:find(searchFilter, 1, true)
                    local p2 = tagLow ~= "" and tagLow:find(searchFilter, 1, true) or nil
                    searchOK = (p1 ~= nil) or (p2 ~= nil)
                end

                if catOK then totalPassedFilter = totalPassedFilter + 1 end

                if catOK and favOK and searchOK then
                    if searchFilter == "" then
                        table.insert(candidates, { name = sword, rank = 0, pos = 0 })
                    else
                        local low = sword:lower()
                        local tag = SWORD_TAGS[sword]
                        local tagLow = tag and tag:lower() or ""
                        local pos = low:find(searchFilter, 1, true) or tagLow:find(searchFilter, 1, true) or 0
                        local rank = 3
                        if pos == 1 then rank = 1
                        elseif low:sub(pos - 1, pos - 1) == " " then rank = 2 end
                        table.insert(candidates, { name = sword, rank = rank, pos = pos })
                    end
                end
            end

            table.sort(candidates, function(a, b)
                if a.rank ~= b.rank then return a.rank < b.rank end
                if a.pos ~= b.pos then return a.pos < b.pos end
                if #a.name ~= #b.name then return #a.name < #b.name end
                return a.name < b.name
            end)

            local count = #candidates
            if safeModeOn and catFilter then
                FilterTag.Text = "FILTER: " .. tostring(catFilter)
                    .. "  (" .. count .. " of " .. totalPassedFilter .. " in category)"
            end

            for _, entry in ipairs(candidates) do
                local sword = entry.name
                local isFav = Favorites[sword] == true
                local tag = SWORD_TAGS[sword]

                local displayName = sword
                if tag then
