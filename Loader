local MESH_ID = "rbxassetid://101851696"
local TEXTURE_ID = "rbxassetid://101851254"

local function cleanCharacterMeshes(char)
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("CharacterMesh") then
            if v.BodyPart == Enum.BodyPart.RightLeg or v.BodyPart == Enum.BodyPart.Head then
                v:Destroy()
            end
        end
    end
end

local lastRecreation = 0
local function applyKorblox(char)
    local now = os.clock()
    if now - lastRecreation < 0.2 then return end
    lastRecreation = now
    local hum = char:FindFirstChildOfClass("Humanoid")
    local isR6 = (hum and hum.RigType == Enum.HumanoidRigType.R6) or char:FindFirstChild("Torso") ~= nil
    if isR6 then
        local rl = char:WaitForChild("Right Leg", 3)
        if not rl then return end
        rl.Transparency = 1
        local old = char:FindFirstChild("AdjustedKorblox")
        if old then old:Destroy() end
        local p = Instance.new("Part")
        p.Name = "AdjustedKorblox"
        p.Size = Vector3.new(1, 1, 1)
        p.CanCollide = false
        p.Massless = true
        local m = Instance.new("SpecialMesh")
        m.MeshId = MESH_ID m.TextureId = TEXTURE_ID m.Scale = Vector3.new(1, 1, 1)
        m.Parent = p
        local w = Instance.new("Weld")
        w.Part0 = p w.Part1 = rl w.C0 = CFrame.new(0, 0, 0) w.Parent = p
        p.Parent = char
    else
        local ul = char:WaitForChild("RightUpperLeg", 3)
        if not ul then return end
        for _, name in ipairs({"RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
            local part = char:FindFirstChild(name)
            if part then
                part.Transparency = 1
                for _, c in ipairs(part:GetDescendants()) do
                    if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 1
                    elseif c:IsA("WrapTarget") then c.Enabled = false
                    elseif c:IsA("BasePart") then c.Transparency = 1 end
                end
            end
        end
        local old = char:FindFirstChild("AdjustedKorblox")
        if old then old:Destroy() end
        local p = Instance.new("Part")
        p.Name = "AdjustedKorblox"
        p.Size = Vector3.new(1, 2, 1)
        p.CanCollide = false
        p.Massless = true
        p.Transparency = 0
        p.Color = Color3.fromRGB(255, 255, 255)
        p.Material = Enum.Material.SmoothPlastic
        local m = Instance.new("SpecialMesh")
        m.MeshId = MESH_ID m.TextureId = TEXTURE_ID m.Scale = Vector3.new(1.15, 1.15, 1.15)
        m.Parent = p
        p.CFrame = ul.CFrame * CFrame.new(0, -0.6, 0.05)
        p.Parent = char
        local w = Instance.new("WeldConstraint")
        w.Part0 = ul w.Part1 = p w.Parent = p
    end
end

local function removeKorblox(char)
    local old = char:FindFirstChild("AdjustedKorblox")
    if old then old:Destroy() end
    local rl = char:FindFirstChild("Right Leg")
    if rl then rl.Transparency = 0 end
    for _, name in ipairs({"RightUpperLeg", "RightLowerLeg", "RightFoot"}) do
        local part = char:FindFirstChild(name)
        if part then
            part.Transparency = 0
            for _, c in ipairs(part:GetDescendants()) do
                if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 0
                elseif c:IsA("WrapTarget") then c.Enabled = true
                elseif c:IsA("BasePart") then c.Transparency = 0 end
            end
        end
    end
end

-- ============================================================
-- HEADLESS SYSTEM (V1 / V2)
-- V1: hides the Head part + its decals/textures.
-- V2: V1 + hides hair and any accessory welded to the Head
--     (hat/hair/face/etc.). Accessories worn from the Avatar Visuals
--     library (ITSAvatar mark) are never hidden, so valks, dominuses
--     and any other library item stay visible on top of headless V2.
-- ============================================================
local function setAccessoryHidden(accessory, state)
    for _, d in ipairs(accessory:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Transparency = state and 1 or 0
        elseif d:IsA("Decal") or d:IsA("Texture") then
            d.Transparency = state and 1 or 0
        elseif d:IsA("WrapTarget") then
            d.Enabled = not state
        end
    end
end

local function getHeadAccessories(char)
    local list = {}
    local head = char:FindFirstChild("Head")
    if not head then return list end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") then
            local isHead = false
            local isNeck = false

            local ok, at = pcall(function() return v.AccessoryType end)
            if ok and at then
                if at == Enum.AccessoryType.Neck then
                    isNeck = true
                elseif at == Enum.AccessoryType.Hat
                   or at == Enum.AccessoryType.Hair
                   or at == Enum.AccessoryType.Face then
                    isHead = true
                end
            end

            if not isNeck and not isHead then
                for _, d in ipairs(v:GetDescendants()) do
                    if d:IsA("BasePart") then
                        for _, w in ipairs(d:GetChildren()) do
                            if w:IsA("Weld") or w:IsA("WeldConstraint") or w:IsA("Motor6D") then
                                local other = (w.Part0 == d) and w.Part1 or w.Part0
                                if other == head then isHead = true break end
                            end
                        end
                    end
                    if isHead then break end
                end
            end

            if isHead then table.insert(list, v) end
        end
    end
    return list
end

local function applyHeadlessState(char)
    if not char or not char.Parent then return end
    local mode = Config.HeadlessMode or "Off"

    -- Head (both V1 and V2 hide it)
    local head = char:FindFirstChild("Head")
    if head then
        local visible = (mode == "Off")
        head.Transparency = visible and 0 or 1
        for _, c in ipairs(head:GetDescendants()) do
            if c:IsA("BasePart") then c.Transparency = visible and 0 or 1
            elseif c:IsA("Decal") or c:IsA("Texture") then c.Transparency = visible and 0 or 1
            elseif c:IsA("WrapTarget") then c.Enabled = visible
            end
        end
    end

    -- Accessories: only V2 hides them - but NEVER items worn from the
    -- Avatar Visuals library (ITSAvatar mark): valks, dominuses, hats
    -- and every other library item stay visible on top of headless V2.
    local accs = getHeadAccessories(char)
    for _, acc in ipairs(accs) do
        if acc:GetAttribute("ITSAvatar") ~= true then
            setAccessoryHidden(acc, mode == "V2")
        end
    end
end

-- ============================================================
-- SAFE SPAWN HANDLING
-- Modifying a character too early (head swap, welded accessories)
-- while the game is still spawning & positioning it can corrupt
-- the humanoid state and leave the player stuck in the ground.
-- ============================================================
local spawnGeneration = 0
local function waitSpawnReady(char, settleFor)
    -- true when char is fully spawned, alive and settled
    if not char or not char.Parent then return false end
    if not char:WaitForChild("Humanoid", 10) then return false end
    if not char:WaitForChild("HumanoidRootPart", 10) then return false end
    local t0 = os.clock()
    settleFor = settleFor or 0.6
    while os.clock() - t0 < settleFor do
        if not char.Parent then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        task.wait(0.1)
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char.Parent ~= nil and hum ~= nil and hum.Health > 0
end
local function unstickCharacter(char)
    -- pops the humanoid back onto the surface if it got wedged at
    -- spawn (stuck in the ground); harmless if the state is fine
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function setupCharacterVisuals(char)
    if not char or not char.Parent then return end
    local hum = char:WaitForChild("Humanoid", 10)
    local isR6 = char:FindFirstChild("Torso") ~= nil or (hum and hum.RigType == Enum.HumanoidRigType.R6)
    char:WaitForChild(isR6 and "Right Leg" or "RightUpperLeg", 10)
    char:WaitForChild("Head", 10)
    -- let the game finish spawning & positioning the character first
    if not waitSpawnReady(char, 0.8) then return end
    cleanCharacterMeshes(char)
    if Config.Korblox then pcall(applyKorblox, char) end
    pcall(applyHeadlessState, char)
    unstickCharacter(char)

    -- Re-apply headless on late-loading accessories
    char.ChildAdded:Connect(function(child)
        if Config.HeadlessMode == "V2" and child:IsA("Accessory") then
            task.wait(0.15)
            pcall(applyHeadlessState, char)
        end
    end)

    -- One extra delayed sweep in case accessories appeared after the first pass
    task.delay(1.5, function()
        if char.Parent then pcall(applyHeadlessState, char) end
    end)
end

if LocalPlayer.Character then task.spawn(setupCharacterVisuals, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupCharacterVisuals)

