-- Shared apply function used by the picker
local function ApplySwordSkin(text)
    if not text or text == "" then return end
    local realName = FindRealSwordName(text)
    if not realName then
        NZNotification.new("Sword", "Not found: " .. text, 3)
        return
    end

    if Config.SafeSwordChanger then
        local real = getgenv().realEquippedSword
        if real and real ~= "" then
            local realCat = GetSwordCategory(real)
            local targetCat = GetSwordCategory(realName)
            local match = false
            if realCat and targetCat then
                if Config.StrictCategory then
                    match = (realCat == targetCat)
                else
                    local realBase = realCat:gsub("^Dual ", "")
                    local skinBase = targetCat:gsub("^Dual ", "")
                    match = (realBase == skinBase)
                end
            else
                match = true
            end
            if not match then
                NZNotification.new(
                    "Safe Changer",
                    "Blocked: real '"..real.."' ["..tostring(realCat)..
                    "] cannot become '"..realName.."' ["..tostring(targetCat).."]",
                    5
                )
                return
            end
        end
    end

    getgenv().swordModel = realName
    getgenv().swordAnimations = realName
    getgenv().swordFX = realName
    if getgenv().skinChanger then
        if getgenv().updateSword then pcall(getgenv().updateSword) end
    else
        getgenv().skinChanger = true
        if getgenv().setSkinChangerToggleUI then getgenv().setSkinChangerToggleUI(true) end
        if getgenv().updateSword then pcall(getgenv().updateSword) end
    end
    if getgenv().saveLastEquippedSword then pcall(getgenv().saveLastEquippedSword, realName) end
    NZNotification.new("Sword", "Equipped: " .. realName, 3)
end

