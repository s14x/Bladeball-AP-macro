local System = { ball = {} }

function System.ball.get_all()
    local t = {}
    local b = Workspace:FindFirstChild("Balls")
    if not b then return t end
    for _, ball in pairs(b:GetChildren()) do
        if ball:GetAttribute("realBall") then ball.CanCollide = false table.insert(t, ball) end
    end
    return t
end

local function IsClashing()
    local char = GetCharacter()
    if not char or not char.PrimaryPart then return false end
    local bf = Workspace:FindFirstChild("Balls")
    if not bf then return false end
    for _, b in pairs(bf:GetChildren()) do
        if b:GetAttribute("realBall") then
            local dist = (char.PrimaryPart.Position - b.Position).Magnitude
            if b:GetAttribute("Target") == LocalPlayer.Name and dist <= 12 then
                return true, b
            end
        end
    end
    return false, nil
end

