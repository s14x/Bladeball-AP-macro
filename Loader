local function CanonicalCategory(cat)
    if not cat or cat == "" then return nil end
    local low = tostring(cat):lower()

    if low:find("dual", 1, true) then
        local base = low:gsub("dual", ""):gsub("%s+", "")
        for _, pair in ipairs(SPECIFIC_CATEGORY_MATCH) do
            if base:find(pair[1], 1, true) then return "Dual " .. pair[2] end
        end
        local baseCanon = CATEGORY_ALIASES[base] or "Dual"
        return "Dual " .. baseCanon
    end

    -- Specific patterns first (order matters)
    for _, pair in ipairs(SPECIFIC_CATEGORY_MATCH) do
        if low:find(pair[1], 1, true) then return pair[2] end
    end

    -- Then the general alias map
    for key, val in pairs(CATEGORY_ALIASES) do
        if low:find(key, 1, true) then return val end
    end

    return cat
end

