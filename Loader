local _capturedRemote, _capturedArgs = nil, nil

pcall(function()
    if not getrawmetatable then return end
    local mt = getrawmetatable(game)
    local old_index = mt.__index
    if setreadonly then setreadonly(mt, false) end
    local newFunc = function(self, key)
        if key == "FireServer" and self:IsA("RemoteEvent") then
            return function(_, ...)
                local args = {...}
                if #args >= 8 and not _capturedRemote then
                    _capturedRemote = self
                    _capturedArgs = args
                end
                return old_index(self, key)(_, unpack(args))
            end
        end
        return old_index(self, key)
    end
    if newcclosure then newFunc = newcclosure(newFunc) end
    mt.__index = newFunc
    if setreadonly then setreadonly(mt, true) end
end)

