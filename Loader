-- ============================================================
-- MACRO LOOP (now on PreSimulation — fires one frame earlier)
-- ============================================================
local timeAccumulator = 0

RunService.PreSimulation:Connect(function(dt)
    _resetFrameCaches()
    if not Config.Spamming then timeAccumulator = 0 return end
    if Config.SafeMode and not IsBlockLegit() then timeAccumulator = 0 return end
    if Config.ParryMethod == "Legit" and not ShouldFireLegit() then timeAccumulator = 0 return end

    local targetCPS = math.clamp(Config.TargetCPS or 200, 5, 500)
    local interval  = 1 / targetCPS
    timeAccumulator += dt
    if timeAccumulator >= interval then
        local fires = math.floor(timeAccumulator / interval)
        timeAccumulator -= fires * interval
        if timeAccumulator > interval * 2 then timeAccumulator = 0 end
        if fires > 200 then fires = 200 end
        for _ = 1, fires do FireParry() end
        if Config.MacroAnimationFix then SpamParryAnimation() end
    end
end)

