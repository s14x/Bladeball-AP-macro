                else
                    b.btn.TextColor3 = Color3.fromRGB(190,190,190)
                    b.btn.BackgroundColor3 = Color3.fromRGB(12,12,12)
                end
            end
            UI.LibHeaderName.Text = lib.name
            LibRecords = FN.libraryRecords(lib)
            FN.applyLibFilter()
        end

        FN.refreshCards = function()
            for _, c in ipairs(UI.LibGrid:GetChildren()) do
                if c:IsA("GuiObject") and string.sub(c.Name, 1, 6) == "vcard_" then
                    local badge = c:FindFirstChild("_worn")
                    local id = tonumber(string.sub(c.Name, 7))
                    if badge and id then
                        local check = CosmeticActive[id]
                        if check then
                            badge.Visible = check() and true or false
                        else
                            badge.Visible = FN.isWorn(id) and true or false
                        end
                    end
                end
            end
            local n = #State.items
            for _, f in pairs(CosmeticActive) do
                if f() then n = n + 1 end
            end
            UI.LibHeaderCount.Text = tostring(n) .. " equipped"
        end

        FN.detectAssetMode = function(rec)
            -- figure out how to wear an item from its own contents (the
            -- library data carries no type info)
            local objs = FN.loadAssetObjects(rec.id)
            if not objs then return false, "asset could not be loaded" end
            local mode
            if FN.findInObjects(objs, "Accessory") then
                mode = "accessory"
            elseif FN.findInObjects(objs, "Tool") then
                mode = "gear"
            elseif FN.findInObjects(objs, "Decal") then
                mode = "face"; rec.class = "Decal"; rec.field = "Face"
            elseif FN.findInObjects(objs, "Shirt") then
                mode = "shirt"; rec.class = "Shirt"; rec.field = "Shirt"
            elseif FN.findInObjects(objs, "Pants") then
                mode = "pants"; rec.class = "Pants"; rec.field = "Pants"
            elseif FN.findInObjects(objs, "ShirtGraphic") then
                mode = "tshirt"; rec.class = "ShirtGraphic"; rec.field = "GraphicTShirt"
            end
            FN.destroyObjects(objs)
            if not mode then return false, "unsupported item type" end
            rec.mode = mode
            return true
        end

        FN.toggleVisual = function(rec)
            if rec.cosmetic then
                -- headless / korblox run through the classic cosmetics engine
                local char = LocalPlayer.Character
                if rec.cosmetic == "headless" then
                    if Config.HeadlessMode == rec.ver then
                        Config.HeadlessMode = "Off"
                        FN.notify("Avatar Visuals", "Headless off", 3)
                    else
                        Config.HeadlessMode = rec.ver
                        FN.notify("Avatar Visuals", "Headless " .. rec.ver .. " on", 3)
                    end
                    saveConfig()
                    if char then pcall(applyHeadlessState, char) end
                elseif rec.cosmetic == "korblox" then
                    Config.Korblox = not Config.Korblox
                    saveConfig()
                    if char then
                        if Config.Korblox then
                            pcall(cleanCharacterMeshes, char)
                            pcall(applyKorblox, char)
                        else
                            pcall(removeKorblox, char)
                        end
                    end
                    FN.notify("Avatar Visuals", "Korblox " .. (Config.Korblox and "on" or "off"), 3)
                end
                FN.refreshCards()
                return
            end
            if rec.detect and not rec.mode then
                local okD, howD = FN.detectAssetMode(rec)
                if not okD then
                    FN.notify("Avatar Visuals", "Failed: " .. tostring(rec.name)
                        .. " (" .. tostring(howD) .. ")", 5)
                    return
                end
            end
            if FN.isWorn(rec.id) then
                FN.removeItem(rec.id)
                FN.repairLimbs(LocalPlayer.Character)
                FN.notify("Avatar Visuals", "Removed: " .. tostring(rec.name), 3)
            else
                local info = TYPE_INFO[rec.typeId]
                if info and info.mode ~= "accessory" and info.mode ~= "gear" then
                    -- one item per slot for heads / body parts
                    for i = #State.items, 1, -1 do
                        if State.items[i].slot == rec.slot then
                            FN.unapplyItem(State.items[i])
                            table.remove(State.items, i)
                        end
                    end
                end
                table.insert(State.items, rec)
                local ok, how = FN.applyItem(rec)
                if not ok and tostring(how):find("load", 1, true) then
                    task.wait(0.35) -- one retry after a load hiccup
                    ok, how = FN.applyItem(rec)
                end
                if ok then
                    FN.notify("Avatar Visuals", "Wearing: " .. tostring(rec.name), 3)
                else
                    for i, x in ipairs(State.items) do
                        if x.id == rec.id then
                            table.remove(State.items, i)
                            break
                        end
                    end
                    FN.notify("Avatar Visuals", "Failed: " .. tostring(rec.name)
                        .. " (" .. tostring(how) .. ")", 5)
                end
            end
            FN.syncWorn()
            FN.refreshCards()
        end

