        FN.applyLibFilter = function()
            LibFiltered = {}
            if LibFilterText == "" then
                for _, r in ipairs(LibRecords) do table.insert(LibFiltered, r) end
            else
                for _, r in ipairs(LibRecords) do
                    if string.find(string.lower(r.name), LibFilterText, 1, true) then
                        table.insert(LibFiltered, r)
                    end
                end
            end
            FN.renderLibBatch(false)
            FN.refreshCards()
        end

        FN.selectLibrary = function(lib)
