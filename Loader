    local function forceRealSword(realName)
        if not realName or realName == "" then return end
        local char = LocalPlayer.Character
        if not char then return end

        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Model") and v.Name ~= realName then
                pcall(function() v:Destroy() end)
            end
        end

        pcall(function() swordInstances:EquipSwordTo(char, realName) end)

        pcall(function()
            if rs.Remotes:FindFirstChild("FireSwordInfo") then
                rs.Remotes.FireSwordInfo:FireServer(realName)
            end
        end)

        if swordsController then
            pcall(function()
                if swordsController.currentSword ~= nil then swordsController.currentSword = realName end
                if swordsController.SwordFX ~= nil then swordsController.SwordFX = realName end
            end)
            pcall(function()
                if swordsController.SetSword then swordsController:SetSword(realName) end
            end)
        end

        pcall(function()
            if LocalPlayer:GetAttribute("CurrentlyEquippedSword") ~= realName then
                LocalPlayer:SetAttribute("CurrentlyEquippedSword", realName)
            end
        end)
    end

    local function safeValidate(notify)
        if not Config.SafeSwordChanger then return true end
        if not getgenv().skinChanger then return true end
        local real = getgenv().realEquippedSword
        local skin = getgenv().swordModel
        if not real or real == "" then return true end
        if not skin or skin == "" then return true end
        if real == skin then return true end

        local realCat = GetSwordCategory(real)
        local skinCat = GetSwordCategory(skin)

        local match = false
        if realCat and skinCat then
            if Config.StrictCategory then
                match = (realCat == skinCat)
            else
                local realBase = realCat:gsub("^Dual ", "")
                local skinBase = skinCat:gsub("^Dual ", "")
                match = (realBase == skinBase)
            end
        else
            match = true
        end

        if match then
            getgenv().safeSwordStatus = "ok"
            return true
        end

        getgenv().safeSwordStatus = "reverted"

        if notify ~= false then
            getgenv().S14x_Notify(
                "Safe Changer",
                "REVERTED: real '"..real.."' ["..tostring(realCat)..
                "] vs skin '"..skin.."' ["..tostring(skinCat).."]",
                6
            )
        end

        getgenv().skinChanger = false
        getgenv().skinChangerEnabled = false
        getgenv().swordModel = ""
        getgenv().swordAnimations = ""
        getgenv().swordFX = ""

        if getgenv().setSkinChangerToggleUI then
            pcall(getgenv().setSkinChangerToggleUI, false)
        end

        forceRealSword(real)
        return false
    end

