local function CanonicalCategory(cat)
    if not cat or cat == "" then return nil end
    local low = tostring(cat):lower()
    if low:find("dual", 1, true) then
        local base = low:gsub("dual", ""):gsub("%s+", ""):gsub("^%s+", ""):gsub("%s+$", "")
        local baseCanon = CATEGORY_ALIASES[base] or CATEGORY_ALIASES[low] or "Dual"
        return "Dual " .. baseCanon
    end
    for key, val in pairs(CATEGORY_ALIASES) do
        if low:find(key, 1, true) then
            return val
        end
    end
    return cat
end

