                        local SizeScale = math.clamp((Input.Position.X - con.AbsolutePosition.X) / con.AbsoluteSize.X, 0, 1)
                        local Main = ((cfg.Max - cfg.Min) * SizeScale) + cfg.Min
                        local Value = Main
                        -- snap to step (e.g. 5 for CPS) BEFORE rounding
