local function GuessCategoryFromName(swordName)
    if not swordName or swordName == "" then return nil end
    local low = swordName:lower()
    for _, rule in ipairs(NAME_CATEGORY_RULES) do
        if low:find(rule.pattern, 1, true) then
            return rule.cat
        end
    end
    return "Sword"
end

local SwordCategoryCache = {}
local function GetSwordCategory(swordName)
    if not swordName or swordName == "" then return nil end
    if SwordCategoryCache[swordName] ~= nil then
        return SwordCategoryCache[swordName]
    end
    local category = nil
    if _swordModuleOK and _swordModule then
        local ok, data = pcall(function() return _swordModule:GetSword(swordName) end)
        if ok and type(data) == "table" then
            category = data.AnimationType or data.SwordType or data.Type or data.Category
        end
    end
    if not category then
        local ok, data = pcall(function()
            return ReplicatedStorage.Shared.ReplicatedInstances.Swords.GetSword:Invoke(swordName)
        end)
        if ok and type(data) == "table" then
            category = data.AnimationType or data.SwordType or data.Type or data.Category
        end
    end
    if not category then
        category = GuessCategoryFromName(swordName)
    end
    category = CanonicalCategory(category) or category
    SwordCategoryCache[swordName] = category
    return category
end

